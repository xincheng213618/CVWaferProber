<Window
    x:Class="CVWaferProber.Views.GlobalConfigWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CVWaferProber.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="GlobalConfigWindow"
    Width="600"
    Height="200"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid Margin="20">
        <!--  布局：2行2列  -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  VAM导出路径标签  -->
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,10,20"
            VerticalAlignment="Center"
            Text="{DynamicResource GlobalConfig.VAMExportPath}" />

        <!--  路径输入框 + 浏览按钮  -->
        <StackPanel
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,0,0,20"
            Orientation="Horizontal">
            <TextBox
                x:Name="txtVamExportPath"
                Width="300"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                IsReadOnly="True"
                Text="{Binding VamExportPath}" />
            <Button
                x:Name="btnBrowse"
                Width="80"
                Click="BtnBrowse_Click"
                Content="{DynamicResource GlobalConfig.Browse}" />
        </StackPanel>

        <!--  保存按钮（跨列居中）  -->
        <Button
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Width="120"
            Margin="0,0,0,0"
            Click="BtnSave_Click"
            Content="{DynamicResource GlobalConfig.Save}" />
    </Grid>
</Window>
