<Window x:Class="CVWaferProber.Views.ConnectionSettingsWindow"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:CVWaferProber.Converters"
        mc:Ignorable="d"
        Title="Connection Settings" Height="250" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <converters:ConnectionStatusToColorConverter x:Key="StatusToColorConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Server Address -->
        <TextBlock Grid.Row="0" Text="Server IP Address:"/>
        <TextBox Grid.Row="1" 
                 Text="{Binding ServerIP, Mode=TwoWay}"
                 IsEnabled="{Binding CanConnect}"/>

        <!-- Port -->
        <TextBlock Grid.Row="2" Text="Port:"/>
        <TextBox Grid.Row="3" 
                 Text="{Binding Port,Mode=TwoWay}"
                 IsEnabled="{Binding CanConnect}"/>

        <!-- Connection Status Display -->
        <Border Grid.Row="4" Margin="5,10" Padding="12" 
                Background="#F8F9FA" CornerRadius="6"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding ConnectionStatusText}" 
                           FontWeight="Bold" FontSize="13">
                    <TextBlock.Foreground>
                        <Binding Path="ConnectionStatusText" Converter="{StaticResource StatusToColorConverter}"/>
                    </TextBlock.Foreground>
                </TextBlock>
                <!--<TextBlock Text="{Binding StatusMessage}" 
                           Foreground="#666666" 
                           FontSize="12"
                           Margin="0,2,0,0"/>-->
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Connect" 
                    Command="{Binding ConnectCommand}"
                    Background="#4CAF50"
                    Foreground="White"
                    FontWeight="SemiBold"/>

            <Button Content="Disconnect" 
                    Command="{Binding DisconnectCommand}"
                    Background="#F44336"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Margin="10,0,0,0"/>

            <Button Content="Close" 
                    Command="{Binding CloseCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Background="#607D8B"
                    Foreground="White"
                    Margin="25,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
