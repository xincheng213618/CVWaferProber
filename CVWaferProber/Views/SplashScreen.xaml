<Window x:Class="CVWaferProber.Views.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" 
        Background="Transparent" Topmost="True"
        Width="600" Height="400">
    <Border CornerRadius="10" BorderThickness="2" 
            BorderBrush="#FF444444" 
            Background="#FF1A1A1A">
        <Grid>
            <!-- 布局：Logo、进度条、信息 -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo和标题区域 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20">
                <Image Source="/Assets/logo_gear.png" Width="40" Height="40"/>
                <TextBlock Text="工业控制台" Foreground="#FFCCCCCC" 
                           FontSize="24" FontWeight="Bold" Margin="10,0,0,0"/>
            </StackPanel>

            <!-- 中央信息区 -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock x:Name="tbStatus" Text="正在初始化核心模块..." 
                           Foreground="#FF00B0F0" FontSize="16" HorizontalAlignment="Center"/>
                <!-- 自定义进度条 -->
                <Border Height="12" Width="400" Background="#FF333333" 
                        CornerRadius="6" Margin="0,20,0,0" HorizontalAlignment="Center">
                    <Border x:Name="progressFill" Height="12" HorizontalAlignment="Left" 
                            Width="0" CornerRadius="6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FF0066CC" Offset="0"/>
                                <GradientStop Color="#FF00B0F0" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Border>
            </StackPanel>

            <!-- 底部版本信息 -->
            <TextBlock Grid.Row="2" Text="V2.1.0 © 2026" Foreground="#FF666666" 
                       HorizontalAlignment="Center" Margin="10"/>
        </Grid>
    </Border>
</Window>
