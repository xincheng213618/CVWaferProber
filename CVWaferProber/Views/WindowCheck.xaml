<Window x:Class="CVWaferProber.Views.WindowCheck"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CVWaferProber.Views"
        mc:Ignorable="d"
        Title="点检窗口" Height="450" Width="800" Initialized="Window_Initialized">
    <Grid>
        <StackPanel Orientation="Horizontal" Margin="5" VerticalAlignment="Top">
            <Button Content="AOI移动到点检位" Margin="0,0,5,0" Click="AOI_Check"/>
            <Button Content="VAM移动到点检位" Margin="0,0,5,0"  Click="VAM_Check"  />
        </StackPanel>
        
    </Grid>
</Window>
