<Window x:Class="CVWaferProber.Views.TestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CVWaferProber.Views"
        xmlns:avalon="https://github.com/Dirkster99/AvalonDock"
        mc:Ignorable="d"
        Title="TestWindow" Height="450" Width="800">
    <Grid>
        <avalon:DockingManager x:Name="DockingManager">
            <avalon:DockingManager.Theme>
                <avalon:GenericTheme />
            </avalon:DockingManager.Theme>

            <avalon:LayoutRoot>
                <avalon:LayoutPanel Orientation="Horizontal">
                    <!-- 主布局面板 - 水平方向分割为两列 -->
                    <avalon:LayoutPanel Orientation="Vertical">

                        <!-- 左列面板组 -->
                        <avalon:LayoutAnchorablePaneGroup DockWidth="400">

                            <!-- 左列第一行 -->
                            <avalon:LayoutAnchorablePane>
                                <avalon:LayoutAnchorable x:Name="LeftPanel1" 
                                                     Title="解决方案资源管理器" 
                                                     CanHide="True" 
                                                     CanClose="False"
                                                     AutoHideWidth="300"
                                                     AutoHideMinWidth="250">
                                    <Border Background="#FFF5F5F5" Margin="5">
                                        <TreeView>
                                            <TreeViewItem Header="项目名称" IsExpanded="True">
                                                <TreeViewItem Header="属性"/>
                                                <TreeViewItem Header="引用"/>
                                                <TreeViewItem Header="MainWindow.xaml"/>
                                                <TreeViewItem Header="MainWindow.xaml.cs"/>
                                            </TreeViewItem>
                                        </TreeView>
                                    </Border>
                                </avalon:LayoutAnchorable>
                            </avalon:LayoutAnchorablePane>

                            <!-- 左列第二行 -->
                            <avalon:LayoutAnchorablePane>
                                <avalon:LayoutAnchorable x:Name="LeftPanel2" 
                                                     Title="输出窗口" 
                                                     CanHide="True" 
                                                     CanClose="False"
                                                     AutoHideMinHeight="150">
                                    <Border Background="Black" Margin="5">
                                        <TextBox Background="Black" Foreground="White" 
                                             BorderThickness="0" IsReadOnly="True"
                                             Text="生成开始...&#x0a;编译完成!&#x0a;生成成功!" 
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                    </Border>
                                </avalon:LayoutAnchorable>
                            </avalon:LayoutAnchorablePane>

                        </avalon:LayoutAnchorablePaneGroup>

                        <!-- 右列面板组 -->
                        <avalon:LayoutAnchorablePaneGroup>

                            <!-- 右列第一行 -->
                            <avalon:LayoutAnchorablePane>
                                <avalon:LayoutAnchorable x:Name="RightPanel1" 
                                                     Title="属性窗口" 
                                                     CanHide="True" 
                                                     CanClose="False"
                                                     AutoHideWidth="300">
                                    <Border Background="#FFF5F5F5" Margin="5">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="文件名: MainWindow.xaml" Margin="5" FontWeight="Bold"/>
                                            <TextBlock Grid.Row="1" Text="路径: C:\Project\AvalonDockDemo\" Margin="5,2,5,2"/>
                                            <TextBlock Grid.Row="2" Text="修改时间: 2024-01-01 10:30:00" Margin="5,2,5,2"/>
                                            <TextBlock Grid.Row="3" Text="大小: 2.5 KB" Margin="5,2,5,10"/>

                                            <StackPanel Grid.Row="4" Orientation="Vertical" Margin="5">
                                                <TextBlock Text="属性:" FontWeight="Bold" Margin="0,0,0,5"/>
                                                <CheckBox Content="只读" Margin="0,2"/>
                                                <CheckBox Content="隐藏" Margin="0,2"/>
                                                <CheckBox Content="存档" Margin="0,2"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </avalon:LayoutAnchorable>
                            </avalon:LayoutAnchorablePane>

                            <!-- 右列第二行 -->
                            <avalon:LayoutAnchorablePane>
                                <avalon:LayoutAnchorable x:Name="RightPanel2" 
                                                     Title="错误列表" 
                                                     CanHide="True" 
                                                     CanClose="False">
                                    <Border Background="#FFF5F5F5" Margin="5">
                                        <DataGrid AutoGenerateColumns="False" CanUserAddRows="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="级别" Width="60" Binding="{Binding Level}"/>
                                                <DataGridTextColumn Header="描述" Width="*" Binding="{Binding Description}"/>
                                                <DataGridTextColumn Header="文件" Width="120" Binding="{Binding File}"/>
                                                <DataGridTextColumn Header="行号" Width="60" Binding="{Binding Line}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </avalon:LayoutAnchorable>

                                <avalon:LayoutAnchorable x:Name="RightPanel3" 
                                                     Title="任务列表" 
                                                     CanHide="True" 
                                                     CanClose="True">
                                    <Border Background="#FFF5F5F5" Margin="5">
                                        <ListBox>
                                            <ListBoxItem Content="✓ 完成布局设计"/>
                                            <ListBoxItem Content="⏳ 实现数据绑定"/>
                                            <ListBoxItem Content="○ 添加主题切换"/>
                                            <ListBoxItem Content="○ 测试功能"/>
                                        </ListBox>
                                    </Border>
                                </avalon:LayoutAnchorable>
                            </avalon:LayoutAnchorablePane>

                        </avalon:LayoutAnchorablePaneGroup>

                    </avalon:LayoutPanel>
                </avalon:LayoutPanel>

                <!-- 定义左右边缘的自动隐藏区域，并预先放置对应的面板 -->
                <avalon:LayoutRoot.LeftSide>
                    <avalon:LayoutAnchorSide>
                        <avalon:LayoutAnchorGroup>
                            <!-- 左边的面板自动隐藏时会停靠到这里 -->
                        </avalon:LayoutAnchorGroup>
                    </avalon:LayoutAnchorSide>
                </avalon:LayoutRoot.LeftSide>

                <avalon:LayoutRoot.RightSide>
                    <avalon:LayoutAnchorSide>
                        <avalon:LayoutAnchorGroup>
                            <!-- 右边的面板自动隐藏时会停靠到这里 -->
                        </avalon:LayoutAnchorGroup>
                    </avalon:LayoutAnchorSide>
                </avalon:LayoutRoot.RightSide>

                <avalon:LayoutRoot.TopSide>
                    <avalon:LayoutAnchorSide>
                        <avalon:LayoutAnchorGroup/>
                    </avalon:LayoutAnchorSide>
                </avalon:LayoutRoot.TopSide>

                <avalon:LayoutRoot.BottomSide>
                    <avalon:LayoutAnchorSide>
                        <avalon:LayoutAnchorGroup/>
                    </avalon:LayoutAnchorSide>
                </avalon:LayoutRoot.BottomSide>

            </avalon:LayoutRoot>
        </avalon:DockingManager>
    </Grid>
</Window>
