<Window
    x:Class="CVWaferProber.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonDock="clr-namespace:AvalonDock;assembly=AvalonDock"
    xmlns:avalonDockLayout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
    xmlns:ccv="clr-namespace:CVWaferProber.Core.Converters;assembly=CVWaferProber.Core"
    xmlns:cv="clr-namespace:CVWaferProber.Converters"
    xmlns:cvsp="clr-namespace:CVWPFSpectrometerCtrl;assembly=CVWPFSpectrometerCtrl"
    xmlns:local="clr-namespace:ChipMapping.Views;assembly=ChipMapping"
    xmlns:vm="clr-namespace:CVWaferProber.ViewModels"
    Title="晶圆台系统"
    Width="1200"
    Height="1000">

    <Window.Resources>
        <cv:StatusToColorConverter x:Key="StatusColorConverter" />
        <ccv:NotBooleanConverter x:Key="NotBooleanConverter" />
    </Window.Resources>
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="550" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  左上：Mapping控件  -->
        <Border
            Grid.Row="0"
            Grid.Column="0"
            Margin="0"
            BorderBrush="Gray"
            BorderThickness="1">
            <local:ChipMappingControl x:Name="MyChipMappingControl" DataContext="{Binding CustomVM}" />
        </Border>

        <!--  左下：结果列表  -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Margin="5"
            BorderBrush="Gray"
            BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="180" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--  操作区域  -->
                <Border
                    Grid.Row="0"
                    Padding="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="#FFF0F0F0"
                    BorderBrush="#FFCCCCCC"
                    BorderThickness="1">

                    <!--  在局部资源中定义转换器  -->
                    <Border.Resources>
                        <ccv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
                    </Border.Resources>

                    <StackPanel Orientation="Vertical">
                        <!--  设置统一的边距来模拟间距  -->
                        <StackPanel.Resources>
                            <Style TargetType="Border">
                                <Setter Property="Margin" Value="0,0,0,10" />
                            </Style>
                        </StackPanel.Resources>

                        <!--  文件操作区域  -->
                        <Border
                            Padding="5"
                            Background="#FFFFFFFF"
                            CornerRadius="6">
                            <DockPanel LastChildFill="True">
                                <Button
                                    x:Name="BtnOpenFile"
                                    Width="80"
                                    Margin="0,0,8,0"
                                    Background="#FF0078D7"
                                    BorderThickness="0"
                                    Command="{Binding OpenMappingFileCommand}"
                                    Content="{DynamicResource BtnOpenFile}"
                                    DockPanel.Dock="Left"
                                    Foreground="White"
                                    IsEnabled="{Binding IsNotProcessing}" />

                                <Button
                                    x:Name="BtnClear"
                                    Width="80"
                                    Margin="8,0,0,0"
                                    Background="#FF6C757D"
                                    BorderThickness="0"
                                    Command="{Binding ClearMappingCommand}"
                                    Content="{DynamicResource BtnClear}"
                                    DockPanel.Dock="Right"
                                    Foreground="White"
                                    IsEnabled="{Binding IsNotProcessing}" />

                                <Button
                                    x:Name="BtnRefresh"
                                    Width="80"
                                    Margin="0,0,8,0"
                                    Background="#FF0D6EFD"
                                    BorderThickness="0"
                                    Command="{Binding LoadMappingFileCommand}"
                                    Content="{DynamicResource BtnRefresh}"
                                    DockPanel.Dock="Right"
                                    Foreground="White"
                                    IsEnabled="{Binding IsNotProcessing}" />

                                <Border
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Background="#FFFFFFFF"
                                    BorderBrush="#FFDDDDDD"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <DockPanel>
                                        <TextBlock
                                            Width="100"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding ProberId}" />
                                        <TextBlock
                                            x:Name="MappingCsvFilePath"
                                            Margin="8,6"
                                            VerticalAlignment="Center"
                                            Foreground="#FF666666"
                                            Text="{Binding MappingCsvFilePath}"
                                            TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </DockPanel>
                        </Border>

                        <!--  测量操作区域  -->
                        <Border
                            Height="90"
                            Margin="0,0,0,0"
                            Padding="5"
                            Background="#FFFFFFFF"
                            CornerRadius="6">
                            <StackPanel>
                                <StackPanel
                                    Height="30"
                                    Margin="5,5"
                                    Orientation="Horizontal">
                                    <Button
                                        Width="120"
                                        Margin="0,0,10,0"
                                        Command="{Binding RCRegCommand}"
                                        Content="{DynamicResource BtnReRegist}"
                                        IsEnabled="{Binding IsNotProcessing}" />
                                    <ComboBox
                                        Width="250"
                                        Height="30"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding IsNotProcessing}"
                                        ItemsSource="{Binding FlowItems}"
                                        SelectedItem="{Binding SelectedFlow, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Width="150" Text="{Binding Name}" />
                                                    <TextBlock Foreground="Blue" Text=" (ID: " />
                                                    <TextBlock Foreground="Blue" Text="{Binding Id}" />
                                                    <TextBlock Foreground="Blue" Text=")" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button
                                        Width="120"
                                        Margin="10,0,0,0"
                                        Command="{Binding FlowLoadCommand}"
                                        Content="{DynamicResource BtnFlowLoad}"
                                        IsEnabled="{Binding IsNotProcessing}" />
                                </StackPanel>
                                <StackPanel
                                    Height="30"
                                    Margin="5,5"
                                    Orientation="Horizontal">
                                    <!--  使用Margin来设置间距  -->
                                    <Button
                                        Width="110"
                                        Margin="0,0,10,0"
                                        BorderThickness="0"
                                        Command="{Binding StartAutoTestCommand}"
                                        Content="{DynamicResource BtnStartAutoTest}" />

                                    <Button
                                        Width="110"
                                        Margin="0,0,10,0"
                                        BorderThickness="0"
                                        Command="{Binding StopAutoTestCommand}"
                                        Content="{DynamicResource BtnStopAutoTest}" />

                                    <Button
                                        Width="110"
                                        BorderThickness="0"
                                        Command="{Binding StartManTestCommand}"
                                        Content="{DynamicResource BtnStartManTest}" />

                                    <Button
                                        Width="110"
                                        Margin="10,0,0,0"
                                        BorderThickness="0"
                                        Command="{Binding RefreshStatusCommand}"
                                        Content="{DynamicResource BtnRefreshStatus}" />


                                    <CheckBox
                                        Margin="10,5,10,0"
                                        Content="{DynamicResource ChkColorStatus}"
                                        IsChecked="{Binding IsColorEnabled}" />

                                    <Button
                                        Width="110"
                                        Margin="10,0,0,0"
                                        BorderThickness="0"
                                        Command="{Binding IVLTestCommand}"
                                        Content="{DynamicResource BtnIVLTest}" />

                                    <!--  替换原来的CheckBox为两个RadioButton  -->
                                    <StackPanel Margin="10,5,10,0" Orientation="Horizontal">
                                        <RadioButton
                                            Margin="0,0,10,0"
                                            Content="光谱仪"
                                            GroupName="IVLDeviceGroup"
                                            IsChecked="{Binding IsIVLCameraEnabled, Converter={StaticResource NotBooleanConverter}}" />
                                        <RadioButton
                                            Content="相机"
                                            GroupName="IVLDeviceGroup"
                                            IsChecked="{Binding IsIVLCameraEnabled}" />
                                    </StackPanel>

                                </StackPanel>
                                <StackPanel
                                    Height="30"
                                    Margin="5,5"
                                    Orientation="Horizontal" />
                            </StackPanel>
                        </Border>

                        <!--  状态指示  -->
                        <Border
                            Padding="10"
                            Background="#FFFFFFFF"
                            CornerRadius="6"
                            Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse
                                    Width="12"
                                    Height="12"
                                    Fill="#FF198754">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="SpinnerTransform" Angle="0" CenterX="6" CenterY="6" />
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        RepeatBehavior="Forever"
                                                        Storyboard.TargetName="SpinnerTransform"
                                                        Storyboard.TargetProperty="Angle"
                                                        From="0"
                                                        To="360"
                                                        Duration="0:0:1" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="#FF666666"
                                    Text="自动测量运行中..." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <DataGrid
                    x:Name="TestResultDataGrid"
                    Grid.Row="1"
                    Margin="5"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding TestResults}"
                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                    SelectionChanged="TestResultDataGrid_SelectionChanged"
                    SelectionMode="Single"
                    SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="50"
                            Binding="{Binding Id}"
                            Header="序号" />
                        <DataGridTextColumn
                            Width="60"
                            Binding="{Binding MapY}"
                            Header="MapYRow" />
                        <DataGridTextColumn
                            Width="60"
                            Binding="{Binding MapX}"
                            Header="MapXCol" />
                        <!--  1.  AOI（Checkbox列）  -->
                        <DataGridTemplateColumn Width="*" Header="AOI">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsAOIEnabled, Mode=TwoWay}"
                                        IsHitTestVisible="True" />
                                    <!--  允许点击  -->
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!--  2. IVL（Checkbox列）  -->
                        <DataGridTemplateColumn Width="*" Header="IVL">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsIVLEnabled, Mode=TwoWay}"
                                        IsHitTestVisible="True" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="200"
                            Binding="{Binding SerialNumber}"
                            Header="序列号" />
                        <DataGridTextColumn
                            Width="180"
                            Binding="{Binding StartTestTime}"
                            Header="开始时间" />
                        <DataGridTextColumn
                            Width="180"
                            Binding="{Binding EndTestTime}"
                            Header="结束时间" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding DisplayStatus}"
                            Header="测试状态" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding DataValue}"
                            Header="均匀性" />
                        <DataGridTextColumn
                            Width="180"
                            Binding="{Binding TotalTime}"
                            Header="总用时" />
                    </DataGrid.Columns>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{Binding Status, Converter={StaticResource StatusColorConverter}}" />
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Grid>
        </Border>

        <!--  右侧区域（保持不变）  -->
        <Grid Grid.RowSpan="2" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  右上相机图像  -->
            <Border
                Grid.Row="0"
                Margin="5"
                BorderBrush="Gray"
                BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--<cvimg:CVCameraImageViewer x:Name="MyImageControl" DataContext="{Binding CustomImageVM}"/>-->
                </Grid>
            </Border>

            <!--  右下图表  -->
            <Border
                Grid.Row="1"
                Margin="5"
                BorderBrush="Gray"
                BorderThickness="1">
                <Grid>
                    <!--<Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>-->

                    <!--<TextBlock Grid.Row="0" Text="测试结果图表" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>-->

                    <cvsp:CVSpectrumAnalyzer
                        x:Name="spaly"
                        Grid.Row="1"
                        DataContext="{Binding CustomSPVM}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>