<Window x:Class="CVWaferProber.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChipMapping.Views;assembly=ChipMapping"
        xmlns:cv="clr-namespace:CVWaferProber.Converters"
        xmlns:vm="clr-namespace:CVWaferProber.ViewModels"
        Title="晶圆台系统" Height="1000" Width="1200">

    <Window.Resources>
        <cv:StatusToColorConverter x:Key="StatusColorConverter"/>
    </Window.Resources>
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="700"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 左上：Mapping控件 -->
        <Border Grid.Row="0" Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="0">
            <local:ChipMappingControl x:Name="MyChipMappingControl" DataContext="{Binding CustomVM}"/>
        </Border>

        <!-- 左下：结果列表 -->
        <Border Grid.Row="1" Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="110"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- 操作区域 -->
                <Border Grid.Row="0" 
                    Background="#FFF0F0F0"
                    BorderBrush="#FFCCCCCC"
                    BorderThickness="1"
                    Padding="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top">

                    <!-- 在局部资源中定义转换器 -->
                    <Border.Resources>
                        <cv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
                    </Border.Resources>
                    
                    <StackPanel Orientation="Vertical">
                        <!-- 设置统一的边距来模拟间距 -->
                        <StackPanel.Resources>
                            <Style TargetType="Border">
                                <Setter Property="Margin" Value="0,0,0,10"/>
                            </Style>
                        </StackPanel.Resources>

                        <!-- 文件操作区域 -->
                        <Border CornerRadius="6" Background="#FFFFFFFF" Padding="5">
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnOpenFile" Content="{DynamicResource BtnOpenFile}" 
                                    Width="80" 
                                    IsEnabled="{Binding IsNotProcessing}"
                                    Command="{Binding OpenMappingFileCommand}" 
                                    DockPanel.Dock="Left" 
                                    Margin="0,0,8,0"
                                    Background="#FF0078D7"
                                    Foreground="White"
                                    BorderThickness="0"/>

                                <Button x:Name="BtnClear" Content="{DynamicResource BtnClear}" 
                                    Width="80" 
                                    IsEnabled="{Binding IsNotProcessing}"
                                    Command="{Binding ClearMappingCommand}" 
                                    DockPanel.Dock="Right" 
                                    Margin="8,0,0,0"
                                    Background="#FF6C757D"
                                    Foreground="White"
                                    BorderThickness="0"/>

                                <Button x:Name="BtnRefresh" Content="{DynamicResource BtnRefresh}" 
                                    Width="80" 
                                    IsEnabled="{Binding IsNotProcessing}"
                                    Command="{Binding LoadMappingFileCommand}" 
                                    DockPanel.Dock="Right" 
                                    Margin="0,0,8,0"
                                    Background="#FF0D6EFD"
                                    Foreground="White"
                                    BorderThickness="0"/>

                                <Border CornerRadius="4"
                                    Background="#FFFFFFFF"
                                    BorderThickness="1"
                                    BorderBrush="#FFDDDDDD"
                                    VerticalAlignment="Center"
                                    Margin="8,0">
                                    <TextBlock x:Name="MappingCsvFilePath" 
                                       Text="{Binding MappingCsvFilePath}" 
                                       Margin="8,6"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="#FF666666"/>
                                </Border>
                            </DockPanel>
                        </Border>

                        <!-- 测量操作区域 -->
                        <Border CornerRadius="6"
                            Background="#FFFFFFFF"
                            Padding="5"
                            Margin="0,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <!-- 使用Margin来设置间距 -->
                                <Button Content="{DynamicResource BtnStartAutoTest}" 
                                    Width="110" 
                                    Command="{Binding StartAutoTestCommand}" 
                                    BorderThickness="0"
                                    Margin="0,0,10,0"/>

                                <Button Content="{DynamicResource BtnStopAutoTest}" 
                                        Width="110" 
                                        Command="{Binding StopAutoTestCommand}" 
                                        BorderThickness="0"/>

                                <Button Content="{DynamicResource BtnRefreshStatus}" 
                                        Width="110" 
                                        Command="{Binding RefreshStatusCommand}" 
                                        BorderThickness="0"
                                        Margin="10,0,0,0"/>

                                <CheckBox Content="{DynamicResource ChkColorStatus}" IsChecked="{Binding IsColorEnabled}" Margin="10,5,10,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 状态指示 -->
                        <Border CornerRadius="6" Background="#FFFFFFFF" Padding="10"
                Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="12" Height="12" Fill="#FF198754">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="SpinnerTransform" Angle="0" CenterX="6" CenterY="6"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="SpinnerTransform" 
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:1" 
                                                     RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock Text="自动测量运行中..." 
                           Foreground="#FF666666"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="1" Text="测试结果列表" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>

                <DataGrid x:Name="TestResultDataGrid" Grid.Row="2" ItemsSource="{Binding TestResults}" 
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="MapYRow" Binding="{Binding MapY}" Width="60"/>
                        <DataGridTextColumn Header="MapXCol" Binding="{Binding MapX}" Width="60"/>
                        <DataGridTextColumn Header="屏幕X坐标" Binding="{Binding ScreenX}" Width="60"/>
                        <DataGridTextColumn Header="屏幕Y坐标" Binding="{Binding ScreenY}" Width="60"/>
                        <DataGridTextColumn Header="测试时间" Binding="{Binding TestTime}" Width="180"/>
                        <DataGridTextColumn Header="测试结果" Binding="{Binding DisplayStatus}" Width="*"/>
                    </DataGrid.Columns>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{Binding Status, Converter={StaticResource StatusColorConverter}}"/>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 右侧区域（保持不变） -->
        <Grid Grid.Column="1" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 右上相机图像 -->
            <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="相机图像" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>

                    <Image Grid.Row="1" Source="{Binding CameraImage}" Stretch="Uniform" Margin="5"/>
                </Grid>
            </Border>

            <!-- 右下图表 -->
            <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="测试结果图表" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>

                    <ContentControl Grid.Row="1" Content="{Binding ChartViewModel}" Margin="5"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>