<Window
    x:Class="CVWaferProber.Views.DockMainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalon="https://github.com/Dirkster99/AvalonDock"
    xmlns:comp="clr-namespace:CVWaferProber.Components"
    xmlns:cv="clr-namespace:CVWaferProber.Converters"
    xmlns:cvimg="clr-namespace:CVWPFCamImageCtrl;assembly=CVWPFCamImageCtrl"
    xmlns:cvsp="clr-namespace:CVWPFSpectrometerCtrl;assembly=CVWPFSpectrometerCtrl"
    xmlns:cvvam="clr-namespace:CVAVMControl;assembly=CVVAMControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CVWaferProber.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:CVWaferProber.ViewModels"
    Title="{DynamicResource CVWaferProber}"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    mc:Ignorable="d">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <cv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <cv:BooleanToGridLengthConverter
            x:Key="BooleanToGridLengthConverter"
            FalseValue="0"
            TrueValue="300" />
        <cv:ConnectionStatusToColorConverter x:Key="StatusToColorConverter" />
        <cv:DeviceStatusToColorConverter x:Key="DevStatusToColorConverter" />

        <Style x:Key="StatusButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <!--<Setter Property="ToolTip" Value="{Binding ConnectionInfo.ServerTipInfo}"/>-->
        </Style>
        <!--  工具栏  -->
    </Window.Resources>

    <Grid>
        <!--  第1行：顶部菜单栏  -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!--  菜单高度自适应  -->
            <RowDefinition Height="*" />

            <!--  剩余空间给docking面板  -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  顶部菜单栏  -->
        <Menu Grid.Row="0" Background="#F0F0F0">
            <!--  文件菜单  -->
            <!--<MenuItem Header="文件(F)" InputGestureText="Alt+F">
                <MenuItem Header="新建项目" Command="{Binding NewProjectCommand}" />
                <MenuItem Header="打开项目" Command="{Binding OpenProjectCommand}" />
                <Separator />
            -->
            <!--  分隔线  -->
            <!--
                <MenuItem Header="保存配置" Command="{Binding SaveConfigCommand}" />
                <Separator />
                <MenuItem Header="退出" Command="{Binding ExitCommand}" InputGestureText="Alt+F4" />
            </MenuItem>

            -->
            <!--  系统菜单  -->
            <MenuItem Header="{DynamicResource Menu.System}" InputGestureText="Alt+S">
                <MenuItem
                    Command="{Binding SysFlowCfgCommand}"
                    Header="{DynamicResource Menu.System.CfgFlows}"
                    InputGestureText="Alt+F" />
                <MenuItem
                    x:Name="MenuSummaryConfig"
                    Command="{Binding OpenSummaryConfigCommand}"
                    Header="{DynamicResource Menu.System.CfgExport}"
                    InputGestureText="Alt+E" />
                <MenuItem
                    x:Name="MenuGlobalConfig"
                    Command="{Binding OpenGlobalConfigCommand}"
                    Header="{DynamicResource Menu.GlobalConfig}"
                    InputGestureText="Alt+G" />
                <!--<MenuItem Header="暂停测试" Command="{Binding PauseTestCommand}" />
                <MenuItem Header="停止测试" Command="{Binding StopTestCommand}" />
                <Separator />
                <MenuItem Header="校准设备" Command="{Binding CalibrateDeviceCommand}" />-->
            </MenuItem>

            <!--  视图菜单（控制面板显示/隐藏）  -->
            <MenuItem x:Name="MenuView" Header="{DynamicResource Menu.View}">
                <MenuItem
                    x:Name="MenuMappingPanel"
                    Header="{DynamicResource Menu.MappingPanelVisible}"
                    InputGestureText="Alt+M"
                    IsCheckable="True"
                    IsChecked="{Binding ElementName=AnchorableMapping, Path=IsVisible, Mode=TwoWay}" />
                <MenuItem
                    x:Name="MenuCameraPanel"
                    Header="{DynamicResource Menu.Layout.Title.AOI}"
                    InputGestureText="Alt+A"
                    IsCheckable="True"
                    IsChecked="{Binding ElementName=AnchorableCamera, Path=IsVisible, Mode=TwoWay}" />
                <MenuItem
                    x:Name="MenuSPPanel"
                    Header="{DynamicResource Dock.Layout.Title.SP}"
                    InputGestureText="Alt+S"
                    IsCheckable="True"
                    IsChecked="{Binding ElementName=AnchorableSP, Path=IsVisible, Mode=TwoWay}" />
                <MenuItem
                    x:Name="MenuVAMSPPanel"
                    Header="{DynamicResource Menu.VAMPanelVisible}"
                    InputGestureText="Alt+V"
                    IsCheckable="True"
                    IsChecked="{Binding ElementName=AnchorableVAM, Path=IsVisible, Mode=TwoWay}" />
                <MenuItem
                    Header="{DynamicResource Menu.LogPanelVisible}"
                    InputGestureText="Alt+L"
                    IsCheckable="True"
                    IsChecked="{Binding ElementName=AnchorableLog, Path=IsVisible, Mode=TwoWay}" />

                <Separator />

            </MenuItem>
            <!--  新增：语言菜单  -->
            <MenuItem Header="{DynamicResource Menu.Language}">
                <!--  中文子菜单  -->
                <MenuItem
                    x:Name="MenuLanguageChinese"
                    Click="LanguageMenuItem_Click"
                    Header="{DynamicResource Menu.Language.Chinese}"
                    InputGestureText="Alt+Shift+C"
                    Tag="Chinese" />
                <!--  英文子菜单  -->
                <MenuItem
                    x:Name="MenuLanguageEnglish"
                    Click="LanguageMenuItem_Click"
                    Header="{DynamicResource Menu.Language.English}"
                    InputGestureText="Alt+Shift+E"
                    Tag="English" />
            </MenuItem>
            <!--  设备菜单  -->
            <MenuItem Header="{DynamicResource Menu.DeviceDebug}" InputGestureText="Alt+D">
                <MenuItem
                    Command="{Binding OpenProberDeviceDebugCommand}"
                    Header="{DynamicResource Menu.ProberDeviceDebug}"
                    InputGestureText="Alt+G" />
            </MenuItem>
            <!--  新增：顶级“导出”菜单  -->
            <!--<MenuItem Header="导出配置(E)" InputGestureText="Alt+E">
                <MenuItem
                    x:Name="MenuSummaryConfig"
                    Command="{Binding OpenSummaryConfigCommand}"
                    Header="Summary导出配置"
                    InputGestureText="Alt+S" />
            </MenuItem>-->
            <!--  帮助菜单  -->
            <MenuItem Header="{DynamicResource Menu.Help}" InputGestureText="Alt+H">
                <MenuItem
                    Command="{Binding OpenHelpCommand}"
                    Header="{DynamicResource Menu.UserManual}"
                    InputGestureText="Alt+U" />
                <MenuItem
                    Command="{Binding OpenAboutCommand}"
                    Header="{DynamicResource Menu.About}"
                    InputGestureText="Alt+T" />
            </MenuItem>
            <!--<MenuItem
                Command="{Binding OpenCommand}"
                Header="VAM Demo"
                InputGestureText="Alt+D" />-->
            <MenuItem
                Command="{Binding ExitCommand}"
                Header="{DynamicResource Menu.Exit}"
                InputGestureText="Alt+F4" />
        </Menu>

        <!--  顶部工具栏  -->
        <DockPanel Grid.Row="1" x:Name="PanelToolbar" >
            <comp:ToolsBarControl DataContext="{Binding ToolsVM}"/>
        </DockPanel>
        
        <avalon:DockingManager x:Name="DockingManager" Grid.Row="2">
            <avalon:DockingManager.Theme>
                <avalon:GenericTheme />
            </avalon:DockingManager.Theme>

            <avalon:LayoutRoot>
                <!--  垂直布局面板：新增顶部行 + 原有水平布局  -->
                <avalon:LayoutPanel Orientation="Vertical">
                    <!--  ========== 原有水平布局部分（左+右面板） ==========  -->
                    <avalon:LayoutPanel Orientation="Horizontal">
                        <!--  左半部分面板  -->
                        <avalon:LayoutPanel Orientation="Vertical">
                            <avalon:LayoutAnchorablePaneGroup
                                x:Name="LeftPaneGroup"
                                DockWidth="300"
                                Orientation="Vertical">
                                <avalon:LayoutAnchorablePane>
                                    <avalon:LayoutAnchorable
                                        x:Name="AnchorableMapping"
                                        Title="{DynamicResource Dock.Layout.Title.Mapping}"
                                        AutoHideMinWidth="20"
                                        AutoHideWidth="300"
                                        CanAutoHide="False"
                                        CanClose="False"
                                        CanDockAsTabbedDocument="False"
                                        CanFloat="False"
                                        CanHide="True">
                                        <DockPanel x:Name="PanelMapping">
                                            <comp:MappingDataControl x:Name="mappingDataControl" />
                                        </DockPanel>
                                    </avalon:LayoutAnchorable>
                                </avalon:LayoutAnchorablePane>
                            </avalon:LayoutAnchorablePaneGroup>
                        </avalon:LayoutPanel>

                        <!--  右半部分面板  -->
                        <avalon:LayoutPanel x:Name="RightPaneGroup" DockWidth="300">
                            <avalon:LayoutAnchorablePaneGroup>
                                <avalon:LayoutAnchorablePane>
                                    <avalon:LayoutAnchorable
                                        x:Name="AnchorableCamera"
                                        Title="AOI"
                                        AutoHideMinHeight="100"
                                        CanAutoHide="False"
                                        CanClose="False"
                                        CanDockAsTabbedDocument="False"
                                        CanFloat="False"
                                        CanHide="True">
                                        <DockPanel x:Name="PanelCamera" Grid.Row="0">
                                            <cvimg:CVCamImagerCtrl x:Name="MyImageControl" DataContext="{Binding CustomImageVM}" />
                                        </DockPanel>
                                    </avalon:LayoutAnchorable>
                                    <avalon:LayoutAnchorable
                                        x:Name="AnchorableSP"
                                        Title="{DynamicResource Dock.Layout.Title.SP}"
                                        CanAutoHide="False"
                                        CanClose="False"
                                        CanDockAsTabbedDocument="False"
                                        CanFloat="False"
                                        CanHide="True">
                                        <DockPanel x:Name="PanelSP" Grid.Row="1">
                                            <cvsp:CVSpectrumAnalyzer x:Name="spaly" DataContext="{Binding CustomIVLVM}" />
                                        </DockPanel>
                                    </avalon:LayoutAnchorable>
                                    <avalon:LayoutAnchorable
                                        x:Name="AnchorableVAM"
                                        Title="VAM"
                                        CanAutoHide="False"
                                        CanClose="False"
                                        CanDockAsTabbedDocument="False"
                                        CanFloat="False"
                                        CanHide="True">
                                        <DockPanel x:Name="PanelVAM" Grid.Row="1">
                                            <cvvam:CVVAMAnalyzer x:Name="MyVAM" />
                                        </DockPanel>
                                    </avalon:LayoutAnchorable>
                                    <avalon:LayoutAnchorable
                                        x:Name="AnchorableLog"
                                        Title="{DynamicResource Dock.Layout.Title.Log}"
                                        AutoHideMinHeight="150"
                                        CanAutoHide="False"
                                        CanClose="False"
                                        CanDockAsTabbedDocument="False"
                                        CanFloat="False"
                                        CanHide="True">
                                        <RichTextBox
                                            x:Name="LogTextBox"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            HorizontalScrollBarVisibility="Auto"
                                            IsReadOnly="True"
                                            VerticalScrollBarVisibility="Auto">
                                            <RichTextBox.Document>
                                                <FlowDocument />
                                            </RichTextBox.Document>
                                            <RichTextBox.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Click="ClearLogMenuItem_Click" Header="{DynamicResource MenuLogClear}" />
                                                </ContextMenu>
                                            </RichTextBox.ContextMenu>
                                        </RichTextBox>
                                    </avalon:LayoutAnchorable>
                                </avalon:LayoutAnchorablePane>
                            </avalon:LayoutAnchorablePaneGroup>
                        </avalon:LayoutPanel>
                    </avalon:LayoutPanel>
                </avalon:LayoutPanel>
            </avalon:LayoutRoot>
        </avalon:DockingManager>

        <StatusBar Grid.Row="3">
            <StatusBarItem Width="150">
                <TextBlock Text="{Binding AppVersion}" />
            </StatusBarItem>
            <!--<Separator/>-->
            <!--  右边区域：连接状态图标和信息  -->
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                    <!--  连接状态指示器  -->
                     <!--Command="{Binding ShowRCConnectionSettingsCommand}"-->
                    <Button
                        Padding="5,0"
                        MouseDoubleClick="Button_Rc_MouseDoubleClick"
                        Style="{StaticResource StatusButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                                Width="12"
                                Height="12"
                                Margin="0,0,8,0"
                                Stroke="Gray"
                                StrokeThickness="1">
                                <Ellipse.Fill>
                                    <Binding Converter="{StaticResource StatusToColorConverter}" Path="RcConnectionInfo.Status" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock VerticalAlignment="Center" Text="{Binding RcConnectionInfo.StatusMessage}" />
                        </StackPanel>
                    </Button>
                    <!--  分隔线  -->
                    <Separator
                        Width="2"
                        Height="15"
                        Margin="0,0,15,0"
                        Background="#CCCCCC" />

                    <!--  连接状态指示器  -->
                        <!-- Command="{Binding ReconnectDevCommand}" -->
                    <Button
                        Padding="0,0"
                        MouseDoubleClick="Button_DoubleClick"
                        Style="{StaticResource StatusButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                                Width="12"
                                Height="12"
                                Margin="0,0,8,0"
                                Stroke="Gray"
                                StrokeThickness="1">
                                <Ellipse.Fill>
                                    <Binding Converter="{StaticResource DevStatusToColorConverter}" Path="ConnectionInfo.DevCurrentState" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock
                                Width="80"
                                VerticalAlignment="Center"
                                Text="{Binding ConnectionInfo.DevStatusMessage}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
