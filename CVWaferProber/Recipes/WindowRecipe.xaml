<Window x:Class="CVWaferProber.Recipes.WindowRecipe"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CVWaferProber.Recipes"
        mc:Ignorable="d"
        Title="Recipe" Height="600" Width="400" Initialized="Window_Initialized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <TabControl>
                <TabItem Header="AOI">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Border Background="AliceBlue" CornerRadius="10" >
                                <StackPanel x:Name="AOIRecipeInfo" Margin="10">

                                </StackPanel>
                            </Border>
                        </ScrollViewer>

                        <Grid Grid.Row="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                                <Button Content="Reset" Click="ResetAOI_Click" Margin="0,0,5,0"/>
                                <Button Content="Save" Click="Save_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                </TabItem>
                <TabItem Header="IVL">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Border Background="AliceBlue" CornerRadius="10" >
                                <StackPanel x:Name="IVLRecipeInfo" Margin="10">

                                </StackPanel>
                            </Border>
                        </ScrollViewer>

                        <Grid Grid.Row="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                                <Button Content="Reset" Click="ResetIVL_Click" Margin="0,0,5,0"/>
                                <Button Content="Save" Click="Save_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="VAM">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Border Background="AliceBlue" CornerRadius="10" >
                                <StackPanel x:Name="VAMRecipeInfo" Margin="10">

                                </StackPanel>
                            </Border>
                        </ScrollViewer>

                        <Grid Grid.Row="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                                <Button Content="Reset" Click="ResetVAM_Click" Margin="0,0,5,0"/>
                                <Button Content="Save" Click="Save_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="EQE">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Border Background="AliceBlue" CornerRadius="10" >
                                <StackPanel x:Name="EQERecipeInfo" Margin="10">

                                </StackPanel>
                            </Border>
                        </ScrollViewer>

                        <Grid Grid.Row="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                                <Button Content="Reset" Click="ResetEQE_Click" Margin="0,0,5,0"/>
                                <Button Content="Save" Click="Save_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>

        </Grid>

    </Grid>
</Window>
