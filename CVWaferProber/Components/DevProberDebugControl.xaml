<UserControl x:Class="CVWaferProber.Components.DevProberDebugControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CVWaferProber.Components"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 连接设置区域 -->
        <GroupBox Grid.Row="0" Header="{DynamicResource ProberDebugControl.ConnCfg}" Margin="10,10,10,5">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="{DynamicResource ProberDebugControl.AddrIP}" VerticalAlignment="Center" Margin="5,0"/>
                <TextBox Text="{Binding ServerIP, Mode=TwoWay}" IsEnabled="{Binding CanConnect}" Width="120" Margin="5,0"/>

                <TextBlock Text="{DynamicResource ProberDebugControl.Port}" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <TextBox Text="{Binding Port,Mode=TwoWay}" IsEnabled="{Binding CanConnect}" Width="80" Margin="5,0"/>

                <Button x:Name="btnConnect" Content="{DynamicResource ProberDebugControl.Connect}" Width="80" Margin="20,0,5,0" Command="{Binding DevProberConnectCommand}"/>
                <Button x:Name="btnDisconnect" Content="{DynamicResource ProberDebugControl.Disconnect}" Width="80" Margin="5,0" Command="{Binding DevProberDisconnectCommand}"/>
            </StackPanel>
        </GroupBox>

        <!-- 状态区域 -->
        <TabControl Grid.Row="1">
            <TabItem Header="{DynamicResource ProberDebugControl.MachineStatus}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="5">
                        <GroupBox Header="{DynamicResource ProberDebugControl.MachineStatus}" Margin="10,5,10,5">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 左侧状态信息 -->
                                    <StackPanel Grid.Column="0" Margin="5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="tbCurrentState" 
                                                       Text="{DynamicResource MachineStatus.CurrentState}" 
                                                       FontWeight="Bold" FontSize="14" Margin="0,0,10,5"/>
                                            <TextBlock x:Name="tbStateDuration" Visibility="Hidden"
                                                       Text="{DynamicResource MachineStatus.Duration}" 
                                                       Foreground="Gray" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="tbWaferInfo" 
                                                   Text="{DynamicResource MachineStatus.WaferInfo}" 
                                                   Margin="0,5"/>
                                        <TextBlock x:Name="tbMechanicalNo" 
                                                   Text="{DynamicResource MachineStatus.MechanicalNo}" 
                                                   Margin="0,5"/>
                                    </StackPanel>

                                    <!-- 右侧状态信息 -->
                                    <StackPanel Grid.Column="1" Margin="5">
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="{DynamicResource Button.ManualStatusUpdate}" 
                                                    Width="120" Margin="0,0,5,0" 
                                                    Command="{Binding ManualStatusUpdateCommand}" Tag="A" />
                                            <Button Content="{DynamicResource Button.MachineNo}" 
                                                    Width="120" Margin="0,0,5,0" Tag="B" 
                                                    Command="{Binding SendBasicCommand}"
                                                    CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/> 
                                            <Button Content="{DynamicResource Button.ReadMapping}" 
                                                    Width="120" Margin="0,0,5,0" Tag="rr" 
                                                    Command="{Binding SendBasicCommand}"
                                                    CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>
                                            <Button Content="{DynamicResource Button.WaferID}" 
                                                    Width="120" Margin="0,0,5,0" Tag="b" 
                                                    Command="{Binding SendBasicCommand}"
                                                    CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>
                                            <Button Content="{DynamicResource Button.BatchNo}" 
                                                    Width="120" Margin="0,0,5,0" Tag="V" 
                                                    Command="{Binding SendBasicCommand}"
                                                    CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>
                                            <Button Content="{DynamicResource Button.WaferInfo}" 
                                                    Width="120" Margin="0,0,5,0" Tag="ku" 
                                                    Command="{Binding SendBasicCommand}"
                                                    CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>
                                            <Button Content="{DynamicResource Button.TotalDieCount}" 
                                                    Width="120" Margin="0,0,5,0" Tag="Y" 
                                                    Command="{Binding SendBasicCommand}"
                                                    CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource ProberDebugControl.MotionStatus}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="5">
                        <GroupBox Header="{DynamicResource ProberDebugControl.MotionStatus}" Margin="10,5,10,5">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 左侧：当前运动状态 -->
                                    <StackPanel Grid.Column="0" Margin="5">
                                        <TextBlock x:Name="tbMotionStatus" 
                                                   Text="{DynamicResource MotionStatus.Status}" 
                                                   FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="tbCurrentMotion" 
                                                   Text="{DynamicResource MotionStatus.CurrentCommand}" 
                                                   Margin="0,2"/>
                                        <TextBlock x:Name="tbMotionDuration" 
                                                   Text="{DynamicResource MotionStatus.RunTime}" 
                                                   Margin="0,2"/>
                                        <TextBlock x:Name="tbTargetPosition" 
                                                   Text="{DynamicResource MotionStatus.TargetPosition}" 
                                                   Margin="0,2"/>
                                        <TextBlock x:Name="tbMotionProgress" 
                                                   Text="{DynamicResource MotionStatus.Progress}" 
                                                   Margin="0,2"/>
                                    </StackPanel>

                                    <!-- 右侧：坐标和Z轴状态 -->
                                    <StackPanel Grid.Column="1" Margin="5">
                                        <TextBlock x:Name="tbCurrentPosition" 
                                                   Text="{DynamicResource MotionStatus.CurrentPosition}" 
                                                   Margin="0,2"/>
                                        <TextBlock x:Name="tbZAxisStatus" 
                                                   Text="{DynamicResource MotionStatus.ZAxisStatus}" 
                                                   Margin="0,2"/>
                                        <Separator Margin="0,10,0,5"/>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="{DynamicResource Button.FirstTestPosition}" 
                                                    Width="120" Margin="0,0,5,0" Tag="q" 
                                                    Command="{Binding SendBasicCommand}"
                                                    CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>
                                            <Button Content="{DynamicResource Button.CurrentTestCoord}" 
                                                    Width="120" Margin="0,0,5,0" Tag="Q" 
                                                    Command="{Binding SendBasicCommand}"
                                                    CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>
                                            <Button Content="{DynamicResource Button.ProbePressure}" 
                                                    Width="120" Margin="0,0,5,0" Tag="QP" 
                                                    Command="{Binding SendBasicCommand}"
                                                    CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>
                                            <Button x:Name="btnResetMotion" 
                                                    Content="{DynamicResource Button.ResetMotion}" 
                                                    Width="120" Margin="0,0,5,0" 
                                                    Command="{Binding ResetMotionCommand}" Visibility="Hidden"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- 运动历史记录 -->
                                <!--<Expander Header="{DynamicResource MotionHistory.Title}" Margin="0,10,0,0">
                                    <DataGrid x:Name="dgMotionHistory" AutoGenerateColumns="False" 
                                              IsReadOnly="True" Height="150" Margin="5">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{DynamicResource MotionHistory.Command}" 
                                                                Binding="{Binding CommandType}" Width="80"/>
                                            <DataGridTextColumn Header="{DynamicResource MotionHistory.TargetY}" 
                                                                Binding="{Binding TargetY}" Width="60"/>
                                            <DataGridTextColumn Header="{DynamicResource MotionHistory.TargetX}" 
                                                                Binding="{Binding TargetX}" Width="60"/>
                                            <DataGridTextColumn Header="{DynamicResource MotionHistory.StartTime}" 
                                                                Binding="{Binding StartTime, StringFormat=HH:mm:ss}" Width="80"/>
                                            <DataGridTextColumn Header="{DynamicResource MotionHistory.Duration}" 
                                                                Binding="{Binding Duration.TotalSeconds, StringFormat=F2}" Width="70"/>
                                            <DataGridTextColumn Header="{DynamicResource MotionHistory.Status}" 
                                                                Binding="{Binding Success}" Width="60">
                                                <DataGridTextColumn.CellStyle>
                                                    <Style TargetType="DataGridCell">
                                                        <Setter Property="Foreground" Value="Green"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Success}" Value="False">
                                                                <Setter Property="Foreground" Value="Red"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.CellStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="{DynamicResource MotionHistory.ErrorMsg}" 
                                                                Binding="{Binding ErrorMessage}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Expander>-->
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource ProberDebugControl.HeaterStatus}" HorizontalAlignment="Left">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="5">
                        <GroupBox Header="{DynamicResource ProberDebugControl.HeaterStatus}" Margin="10,5,10,5">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 左侧：温度信息 -->
                                    <StackPanel Grid.Column="0" Margin="5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="tbCurrentTemp" 
                                                       Text="{DynamicResource Heater.CurrentTemp}" 
                                                       FontWeight="Bold" FontSize="14" Margin="0,0,10,5"/>
                                            <TextBlock x:Name="tbSetTemp" 
                                                       Text="{DynamicResource Heater.SetTemp}" 
                                                       Foreground="Gray" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="tbHeaterStatus" 
                                                   Text="{DynamicResource Heater.HeaterStatus}" 
                                                   Margin="0,2"/>
                                    </StackPanel>

                                    <!-- 右侧：状态和控制 -->
                                    <StackPanel Grid.Column="1" Margin="5">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="{DynamicResource Heater.SetTemperature}" 
                                                       VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox x:Name="txtSetTemperature" Text="{Binding Temperature}" 
                                                     Width="60" Margin="0,0,5,0"/>
                                            <Button x:Name="btnSetTemperature" 
                                                    Content="{DynamicResource Button.SetTemperature}" 
                                                    Width="60" Command="{Binding SetTemperatureCommand}"/>
                                        </StackPanel>
                                        <WrapPanel Margin="0,5,0,0">
                                            <Button x:Name="btnGetCurrentTemp" 
                                                    Content="{DynamicResource Button.GetCurrentTemp}" 
                                                    Width="80" Margin="5,0" Command="{Binding GetCurrentTempCommand}"/>
                                            <Button x:Name="btnGetHeaterStatus" 
                                                    Content="{DynamicResource Button.GetHeaterStatus}" 
                                                    Width="80" Margin="0,0,5,0" Command="{Binding GetHeaterStatusCommand}"/>
                                            <Button x:Name="btnResetHeaterStats" 
                                                    Content="{DynamicResource Button.ResetHeaterStats}" 
                                                    Width="80" Margin="5,0" Click="BtnResetHeaterStats_Click" Visibility="Hidden"/>
                                            <Button Content="{DynamicResource Button.StartHeaterMonitor}" 
                                                    Width="80" Margin="5,0" Command="{Binding StartHeaterMonitorCommand}" Visibility="Hidden"/>
                                            <Button Content="{DynamicResource Button.StopHeaterMonitor}" 
                                                    Width="80" Margin="5,0" Command="{Binding StopHeaterMonitorCommand}" Visibility="Hidden"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- 温度历史图表 -->
                                <Expander Header="{DynamicResource Heater.TempHistory}" Margin="0,10,0,0" Expanded="Expander_Expanded" Visibility="Hidden">
                                    <StackPanel>
                                        <Canvas x:Name="canvasTempChart" Height="150" Background="White" Margin="5"/>
                                        <TextBlock x:Name="tbTempStats" 
                                                   Text="{DynamicResource Heater.Stats}" 
                                                   HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 主内容区域 -->
        <Grid Grid.Row="2" Margin="10,5,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：指令发送区域 -->
            <TabControl Grid.Column="0" Margin="0,0,5,0">
                <TabItem Header="{DynamicResource MotionControl.Title}">
                    <StackPanel Margin="5">
                        <StackPanel Margin="5">
                            <StackPanel Margin="5" Orientation="Horizontal">
                                <Button Width="150" Content="{DynamicResource MotionControl.ZUp}" Margin="5" Tag="Z" 
                                        Command="{Binding SendBasicCommand}"
                                        CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>
                                <Button Width="150" Content="{DynamicResource MotionControl.ZDown}" Margin="5" Tag="D" 
                                        Command="{Binding SendBasicCommand}"
                                        CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>
                                <Button Width="150" Content="{DynamicResource MotionControl.LZAllUp}" Margin="5" Tag="gu" 
                                        Command="{Binding SendBasicCommand}"
                                        CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>
                            </StackPanel>
                            <StackPanel Margin="5" Orientation="Horizontal">
                                    <Button Width="150" Content="{DynamicResource MotionControl.ZPosMainCamera}" Margin="5" Tag="gm" 
                                        Command="{Binding SendBasicCommand}"
                                        CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>
                                <Button Width="150" Content="{DynamicResource MotionControl.ZPosAUXCamera}" Margin="5" Tag="ga" 
                                        Command="{Binding SendBasicCommand}"
                                        CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>
                                <Button Width="150" Content="{DynamicResource MotionControl.ZPosINT}" Margin="5" Tag="gi" 
                                        Command="{Binding SendBasicCommand}"
                                        CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>
                            </StackPanel>
                            <StackPanel Margin="5" Orientation="Horizontal">
                                <Button Width="150" Content="{DynamicResource MotionControl.ZPosQ}" Margin="5" Tag="gc" 
                                        Command="{Binding SendBasicCommand}"
                                        CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>
                                <Button Width="150" Content="{DynamicResource MotionControl.TestComplete}" Margin="5" Tag="J" 
                                        Command="{Binding SendBasicCommand}"
                                        CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>
                                <Button Width="150" Content="{DynamicResource MotionControl.StopCommand}" Margin="5" Tag="K" 
                                        Command="{Binding SendBasicCommand}" 
                                        CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <GroupBox Header="{DynamicResource MotionControl.AbsoluteMove}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="$JY+020X-020#" Margin="5,5,5,2"/>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <TextBlock Text="Y:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBox x:Name="txtAbsY" Text="{Binding AbsAxisY}" Width="60" Margin="0,0,10,0"/>
                                        <TextBlock Text="X:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBox x:Name="txtAbsX" Text="{Binding AbsAxisX}" Width="60" Margin="0,0,10,0"/>
                                        <Button Content="{DynamicResource MotionControl.SendMoveCommand}" Width="150" 
                                                Command="{Binding SendAbsoluteMoveCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <TabItem Header="{DynamicResource CustomCommand.Title}">
                    <StackPanel Margin="10">
                        <GroupBox Header="{DynamicResource CustomCommand.Title}">
                            <StackPanel Margin="5">
                                <TextBlock Text="{DynamicResource CustomCommand.InstructionFormat}" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="{DynamicResource CustomCommand.CommandContent}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox x:Name="txtCustomCommand" Text="{Binding CustomCMD}" Width="200"/>
                                </StackPanel>
                                <Button Content="{DynamicResource CustomCommand.Send}" Width="120" Command="{Binding SendCustomCommand}"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="{DynamicResource CustomCommand.InstructionDesc}" Margin="0,10,0,0">
                            <TextBlock Margin="5">
                                <Run Text="{DynamicResource CustomCommand.HeaderPrefix}"/>
                                <Run Text="{DynamicResource CustomCommand.Header}"/>
                                <LineBreak/>
                                <Run Text="{DynamicResource CustomCommand.InstructionField}"/>
                                <Run Text="{DynamicResource CustomCommand.InstructionFieldDesc}"/>
                                <LineBreak/>
                                <Run Text="{DynamicResource CustomCommand.DataContent}"/>
                                <Run Text="{DynamicResource CustomCommand.DataContentDesc}"/>
                                <LineBreak/>
                                <Run Text="{DynamicResource CustomCommand.ProtocolTail}"/>
                                <Run Text="{DynamicResource CustomCommand.ProtocolTailChar}"/>
                                <LineBreak/>
                                <LineBreak/>
                                <Run Text="{DynamicResource CustomCommand.Examples}"/>
                                <LineBreak/>
                                <Run Text="{DynamicResource CustomCommand.Example1}"/>
                                <Run Text="{DynamicResource CustomCommand.Example1Desc}"/>
                                <LineBreak/>
                                <Run Text="{DynamicResource CustomCommand.Example2}"/>
                                <Run Text="{DynamicResource CustomCommand.Example2Desc}"/>
                            </TextBlock>
                        </GroupBox>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- 右侧：通信日志区域 -->
            <GroupBox Grid.Column="1" Header="{DynamicResource CommLog.Title}" Margin="5,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                        <Button Content="{DynamicResource CommLog.Clear}" Margin="0,0,10,0" Click="ClearLog_Click"/>
                        <CheckBox x:Name="chkAutoScroll" Content="{DynamicResource CommLog.AutoScroll}" 
                                  IsChecked="True" VerticalAlignment="Center"/>
                    </StackPanel>
                    <RichTextBox x:Name="txtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                                 HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12">
                        <RichTextBox.Background>
                            <SolidColorBrush Color="#FF1E1E1E"/>
                        </RichTextBox.Background>
                        <FlowDocument>
                            <Paragraph>
                                <Run Text="{DynamicResource CommLog.Ready}" Foreground="LightGray"/>
                            </Paragraph>
                        </FlowDocument>
                    </RichTextBox>
                </DockPanel>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>