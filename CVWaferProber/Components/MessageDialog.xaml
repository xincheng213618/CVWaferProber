<Window x:Class="CVWaferProber.Components.MessageDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{DynamicResource MessageTitle}" 
        Height="200" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 消息内容 -->
        <TextBlock x:Name="MessageTextBlock" 
                   Grid.Row="0"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontSize="14"
                   TextAlignment="Center"/>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="1" 
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Margin="0,15,0,0">

            <!-- OK按钮 - 默认显示 -->
            <Button x:Name="OkButton"
                    Content="{DynamicResource OKButtonText}"
                    Click="OkButton_Click"
                    IsDefault="True"/>

            <!-- Cancel按钮 - 默认隐藏 -->
            <Button x:Name="CancelButton"
                    Content="{DynamicResource CancelButtonText}"
                    Click="CancelButton_Click"
                    IsCancel="True"
                    Visibility="Collapsed"/>

            <!-- Yes按钮 - 默认隐藏 -->
            <Button x:Name="YesButton"
                    Content="{DynamicResource YesButtonText}"
                    Click="YesButton_Click"
                    Visibility="Collapsed"/>

            <!-- No按钮 - 默认隐藏 -->
            <Button x:Name="NoButton"
                    Content="{DynamicResource NoButtonText}"
                    Click="NoButton_Click"
                    Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>
