<UserControl
    x:Class="CVWaferProber.Components.MappingDataControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ccv="clr-namespace:CVWaferProber.Core.Converters;assembly=CVWaferProber.Core"
    xmlns:cv="clr-namespace:CVWaferProber.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CVWaferProber.Components"
    xmlns:map="clr-namespace:ChipMapping.Views;assembly=ChipMapping"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:CVWaferProber.ViewModels" >
   
    <UserControl.Resources>
        <cv:StatusToColorConverter x:Key="StatusColorConverter" />
        <ccv:NotBooleanConverter x:Key="NotBooleanConverter" />
        <!--  新增：表头Checkbox样式（统一外观）  -->
        <Style x:Key="HeaderCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <!--  表头按钮样式（统一外观，适配紧凑布局）  -->
        <Style x:Key="HeaderActionButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="20" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Background" Value="#FFE0E0E0" />
            <Setter Property="BorderBrush" Value="#FFCCCCCC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF0078D7" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="#FF005FB8" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF005FB8" />
                    <Setter Property="BorderBrush" Value="#FF00479E" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!--  单元格复选框样式（保持原有）  -->
        <Style x:Key="CellCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
    </UserControl.Resources>

    <Border
        Margin="0"
        BorderBrush="Gray"
        BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="5*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Border
                    Margin="5"
                    BorderBrush="Gray"
                    BorderThickness="1">
                    <map:ChipMappingControl x:Name="MyChipMappingControl" DataContext="{Binding CustomMappingVM}" />
                </Border>

            </Grid>
            <!--  添加GridSplitter  -->
            <GridSplitter
                Grid.Row="1"
                Height="5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="Transparent"
                ShowsPreview="True" />
            <Grid Grid.Row="2">
                <Border
                    Margin="5"
                    BorderBrush="Gray"
                    BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="180" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!--  操作区域  -->
                        <Border
                            Grid.Row="0"
                            Padding="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Background="#FFF0F0F0"
                            BorderBrush="#FFCCCCCC"
                            BorderThickness="0">
                            <!--  在局部资源中定义转换器  -->
                            <Border.Resources>
                                <ccv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
                            </Border.Resources>

                            <StackPanel Orientation="Vertical">
                                <!--  设置统一的边距来模拟间距  -->
                                <StackPanel.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="Margin" Value="0,0,0,10" />
                                    </Style>
                                </StackPanel.Resources>

                                <!--  文件操作区域  -->
                                <Border
                                    Padding="5"
                                    Background="#FFFFFFFF"
                                    CornerRadius="6">
                                    <DockPanel LastChildFill="True">
                                        <Button
                                            x:Name="BtnOpenFile"
                                            Width="80"
                                            Margin="0,0,8,0"
                                            Background="#FF0078D7"
                                            BorderThickness="0"
                                            Command="{Binding OpenMappingFileCommand}"
                                            Content="{DynamicResource BtnOpenFile}"
                                            DockPanel.Dock="Left"
                                            Foreground="White"
                                            IsEnabled="{Binding IsNotProcessing}" />

                                        <Button
                                            x:Name="BtnResetStatus"
                                            Width="80"
                                            Margin="8,0,0,0"
                                            Background="#FF0D6EFD"
                                            BorderThickness="0"
                                            Command="{Binding ResetStatusCommand}"
                                            Content="{DynamicResource BtnResetStatus}"
                                            DockPanel.Dock="Right"
                                            Foreground="White"
                                            IsEnabled="{Binding IsNotProcessing}" />

                                        <!--<Button x:Name="BtnClear" Content="{DynamicResource BtnClear}"
                                                                  Width="80"
                                                                  IsEnabled="{Binding IsNotProcessing}"
                                                                  Command="{Binding ClearMappingCommand}"
                                                                  DockPanel.Dock="Right"
                                                                  Margin="8,0,0,0"
                                                                  Background="#FF6C757D"
                                                                  Foreground="White"
                                                                  BorderThickness="0"/>-->

                                        <Button
                                            x:Name="BtnReload"
                                            Width="80"
                                            Margin="0,0,0,0"
                                            Background="#FF0D6EFD"
                                            BorderThickness="0"
                                            Command="{Binding LoadMappingFileCommand}"
                                            Content="{DynamicResource BtnReload}"
                                            DockPanel.Dock="Right"
                                            Foreground="White"
                                            IsEnabled="{Binding IsNotProcessing}" />


                                        <DockPanel>
                                            <TextBlock
                                                x:Name="MappingCsvFilePath"
                                                Margin="8,6"
                                                VerticalAlignment="Center"
                                                Foreground="#FF666666"
                                                Text="{Binding MappingCsvFilePath}"
                                                TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DockPanel>
                                </Border>

                                <!--  测量操作区域  -->
                                <Border
                                    Height="90"
                                    Margin="0,0,0,0"
                                    Background="#FFFFFFFF"
                                    CornerRadius="6">
                                    <StackPanel>
                                        <StackPanel
                                            Height="30"
                                            Margin="5,5"
                                            Orientation="Horizontal">
                                            <!-- <Button Content="{DynamicResource BtnReRegist}" Command="{Binding RCRegCommand}"  IsEnabled="{Binding IsNotProcessing}" Width="120" Margin="0,0,10,0"/>  -->
                                            <ComboBox
                                                Width="250"
                                                Height="30"
                                                VerticalAlignment="Center"
                                                IsEnabled="{Binding IsNotProcessing}"
                                                ItemsSource="{Binding WPFlows}"
                                                SelectedItem="{Binding SelectedWPFlow, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Width="100" Text="{Binding Name}" />
                                                            <TextBlock Foreground="Blue" Text=" (Type: " />
                                                            <TextBlock Foreground="Blue" Text="{Binding FlowType}" />
                                                            <TextBlock Foreground="Blue" Text=")" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button
                                                Width="120"
                                                Margin="10,0,0,0"
                                                Command="{Binding FlowLoadCommand}"
                                                Content="{DynamicResource BtnFlowLoad}"
                                                IsEnabled="{Binding IsNotProcessing}" />

                                            <StackPanel Margin="5" Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Text="PN" />
                                                <TextBox
                                                    Width="100"
                                                    Margin="5,0,0,0"
                                                    IsEnabled="{Binding IsNotProcessing}"
                                                    Text="{Binding ProberId}" />
                                                <TextBlock VerticalAlignment="Center" Text="SN" />
                                                <TextBox
                                                    Width="150"
                                                    Margin="5,0"
                                                    IsEnabled="{Binding IsNotProcessing}"
                                                    IsReadOnly="{Binding IsAutoSN}"
                                                    Text="{Binding SerialNumber}" />
                                                <!--<CheckBox
                                                Text="{Binding Timestamp}"
                                                    x:Name="ChkIsAutoSN"
                                                    Content="{DynamicResource Auto SN}"
                                                    IsChecked="{Binding IsAutoSN}"
                                                    IsEnabled="{Binding IsNotProcessing}" RenderTransformOrigin="0.572,0.675" />-->
                                                <Button
                                                    Width="110"
                                                    Margin="0,0,10,0"
                                                    BorderThickness="0"
                                                    Command="{Binding SearchCommand}"
                                                    Content="{DynamicResource BtnSearch}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <DockPanel Height="30" Margin="5,5">
                                            <!--  使用Margin来设置间距  -->
                                            <Button
                                                Width="110"
                                                Margin="0,0,10,0"
                                                BorderThickness="0"
                                                Command="{Binding StartAutoTestCommand}"
                                                Content="{DynamicResource BtnStartAutoTest}"
                                                IsEnabled="{Binding IsNotProcessing}" />

                                            <Button
                                                Width="110"
                                                Margin="0,0,10,0"
                                                BorderThickness="0"
                                                Command="{Binding StopAutoTestCommand}"
                                                Content="{DynamicResource BtnStopAutoTest}" />

                                            <Button
                                                Width="110"
                                                Margin="0,0,0,0"
                                                BorderThickness="0"
                                                Command="{Binding RefreshStatusCommand}"
                                                Content="{DynamicResource BtnRefreshStatus}" />

                                            <CheckBox
                                                Margin="10,5,10,0"
                                                Content="{DynamicResource ChkColorStatus}"
                                                IsChecked="{Binding IsColorEnabled}" />

                                            <Button
                                                Width="110"
                                                Margin="0,0,10,0"
                                                BorderThickness="0"
                                                Command="{Binding StartManTestCommand}"
                                                Content="{DynamicResource BtnStartManTest}"
                                                IsEnabled="{Binding IsNotProcessing}" />
                                            <!--<Button Content="{DynamicResource BtnOpenVEyeWindow}" Width="110" Command="{Binding OpenVEyeWindowCommand}" Margin="0,0,10,0" BorderThickness="0"/>-->

                                            <DockPanel Width="230" HorizontalAlignment="Right">
                                                <Button
                                                    Width="110"
                                                    Margin="0,0,10,0"
                                                    BorderThickness="0"
                                                    Command="{Binding SaveTestResultCommand}"
                                                    Content="{DynamicResource BtnSaveTestResult}"
                                                    IsEnabled="{Binding IsNotProcessing}" />
                                                <Button
                                                    Width="110"
                                                    BorderThickness="0"
                                                    Command="{Binding LoadTestResultCommand}"
                                                    Content="{DynamicResource BtnLoadTestResult}"
                                                    IsEnabled="{Binding IsNotProcessing}" />
                                            </DockPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!--  状态指示  -->
                                <Border
                                    Padding="10"
                                    Background="#FFFFFFFF"
                                    CornerRadius="6"
                                    Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse
                                            Width="12"
                                            Height="12"
                                            Fill="#FF198754">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform x:Name="SpinnerTransform" Angle="0" CenterX="6" CenterY="6" />
                                            </Ellipse.RenderTransform>
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                RepeatBehavior="Forever"
                                                                Storyboard.TargetName="SpinnerTransform"
                                                                Storyboard.TargetProperty="Angle"
                                                                From="0"
                                                                To="360"
                                                                Duration="0:0:1" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="#FF666666"
                                            Text="测量运行中..." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Margin="0,5"
                            BorderBrush="Gray"
                            BorderThickness="0">
                            <DataGrid
                                x:Name="TestResultDataGrid"
                                AutoGenerateColumns="False"
                                HorizontalScrollBarVisibility="Auto"
                                IsReadOnly="False"
                                ItemsSource="{Binding TestResults}"
                                SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                SelectionMode="Single"
                                SelectionUnit="FullRow"
                                VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        
                                        Binding="{Binding Id}"
                                        Header="{DynamicResource GridHeader.No}" />
                                    <DataGridTextColumn
                                       
                                        Binding="{Binding MapY}"
                                        Header="{DynamicResource Maping.GridHeader.Row}" />
                                    <DataGridTextColumn
                                        
                                        Binding="{Binding MapX}"
                                        Header="{DynamicResource Maping.GridHeader.Col}" />
                                    <!--  1. AOI列（全选/反选改为按钮）  -->
                                    <DataGridTemplateColumn >
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                                    <TextBlock
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Text="AOI" />
                                                    <StackPanel  Orientation="Horizontal">
                                                    <!--  全选按钮  -->
                                                        <CheckBox x:Name="selectAllCheckBox" 
                                  IsChecked="{Binding DataContext.SelectAllAOI, 
                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"                              
                                  VerticalAlignment="Center"/>
                                                        <!--<Button
                                                        Command="{Binding SelectAllAOICommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        Content="{DynamicResource Maping.GridHeader.SelectAll}"
                                                        Style="{StaticResource HeaderActionButtonStyle}"
                                                        ToolTip="{DynamicResource Maping.GridHeader.SelectAll}" />-->
                                                    <!--  反选按钮  -->
                                                    <Button
                                                        Command="{Binding InvertSelectAOICommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        Content="{DynamicResource Maping.GridHeader.ReverseSelection}"
                                                        Style="{StaticResource HeaderActionButtonStyle}"
                                                        ToolTip="{DynamicResource Maping.GridHeader.ReverseSelection}" />
                                                </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding IsAOIEnabled, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                                    IsHitTestVisible="True"
                                                    Style="{StaticResource CellCheckBoxStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--  2. IVL列（全选/反选改为按钮）  -->
                                    <DataGridTemplateColumn >
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Text="IVL" />
                                                    <Button
                                                        Command="{Binding SelectAllIVLCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        Content="{DynamicResource Maping.GridHeader.SelectAll}"
                                                        Style="{StaticResource HeaderActionButtonStyle}"
                                                        ToolTip="{DynamicResource Maping.GridHeader.SelectAll}" />
                                                    <Button
                                                        Command="{Binding InvertSelectIVLCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        Content="{DynamicResource Maping.GridHeader.ReverseSelection}"
                                                        Style="{StaticResource HeaderActionButtonStyle}"
                                                        ToolTip="{DynamicResource Maping.GridHeader.ReverseSelection}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding IsIVLEnabled, Mode=TwoWay}"
                                                    IsHitTestVisible="True"
                                                    Style="{StaticResource CellCheckBoxStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--  3. EQE列（全选/反选改为按钮）  -->
                                    <DataGridTemplateColumn >
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Text="EQE" />
                                                    <Button
                                                        Command="{Binding SelectAllEQECommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        Content="{DynamicResource Maping.GridHeader.SelectAll}"
                                                        Style="{StaticResource HeaderActionButtonStyle}"
                                                        ToolTip="{DynamicResource Maping.GridHeader.SelectAll}" />
                                                    <Button
                                                        Command="{Binding InvertSelectEQECommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        Content="{DynamicResource Maping.GridHeader.ReverseSelection}"
                                                        Style="{StaticResource HeaderActionButtonStyle}"
                                                        ToolTip="{DynamicResource Maping.GridHeader.ReverseSelection}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding IsEQEEnabled, Mode=TwoWay}"
                                                    IsHitTestVisible="True"
                                                    Style="{StaticResource CellCheckBoxStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--  4. VAM列（全选/反选改为按钮）  -->
                                    <DataGridTemplateColumn >
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Text="VAM" />
                                                    <Button
                                                        Command="{Binding SelectAllVAMCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        Content="{DynamicResource Maping.GridHeader.SelectAll}"
                                                        Style="{StaticResource HeaderActionButtonStyle}"
                                                        ToolTip="{DynamicResource Maping.GridHeader.SelectAll}" />
                                                    <Button
                                                        Command="{Binding InvertSelectVAMCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        Content="{DynamicResource Maping.GridHeader.ReverseSelection}"
                                                        Style="{StaticResource HeaderActionButtonStyle}"
                                                        ToolTip="{DynamicResource Maping.GridHeader.ReverseSelection}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding IsVAMEnabled, Mode=TwoWay}"
                                                    IsHitTestVisible="True"
                                                    Style="{StaticResource CellCheckBoxStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn
                                        
                                        Binding="{Binding SerialNumber, Mode=TwoWay}"
                                        Header="{DynamicResource Maping.GridHeader.SerialNumber}" />
                                    <DataGridTextColumn
                                      
                                        Binding="{Binding DisplayStatus}"
                                        Header="{DynamicResource Maping.GridHeader.TestStatus}" />
                                    <DataGridTextColumn
                                       
                                        Binding="{Binding DataValue}"
                                        Header="{DynamicResource Maping.GridHeader.Uniformity}" />
                                    <DataGridTextColumn
                                       
                                        Binding="{Binding StartTestTime}"
                                        Header="{DynamicResource Maping.GridHeader.StartTestTime}" />
                                    <DataGridTextColumn
                                      
                                        Binding="{Binding EndTestTime}"
                                        Header="{DynamicResource Maping.GridHeader.EndTestTime}" />

                                    <DataGridTextColumn
                                       
                                        Binding="{Binding TotalTime}"
                                        Header="{DynamicResource Maping.GridHeader.TotalTime}" />
                                </DataGrid.Columns>

                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="{Binding Status, Converter={StaticResource StatusColorConverter}}" />
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>
                        </Border>

                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
