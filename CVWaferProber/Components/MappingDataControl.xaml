                                <ccv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
                            </Border.Resources>

                            <StackPanel Orientation="Vertical">
                                <!--  设置统一的边距来模拟间距  -->
                                <StackPanel.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="Margin" Value="0,0,0,10" />
                                    </Style>
                                </StackPanel.Resources>

                                <!--  文件操作区域  -->
