                                <!--
                                            <Button
                                                Width="100"
                                                Margin="0,0,10,0"
                                                BorderThickness="0"
                                                Command="{Binding StartAutoTestCommand}"
                                                Content="{DynamicResource BtnStartAutoTest}"
                                                IsEnabled="{Binding IsNotProcessing}" />

                                            <Button
                                                Width="100"
                                                Margin="0,0,10,0"
                                                BorderThickness="0"
                                                Command="{Binding StopAutoTestCommand}"
                                                Content="{DynamicResource BtnStopAutoTest}" />

                                            <Button
                                                Width="110"
                                                Margin="0,0,0,0"
                                                BorderThickness="0"
                                                Command="{Binding RefreshStatusCommand}"
                                                Content="{DynamicResource BtnRefreshStatus}" />

                                            <CheckBox
                                                Margin="10,5,10,0"
                                                Content="{DynamicResource ChkColorStatus}"
                                                IsChecked="{Binding IsColorEnabled}" />

                                            <Button
                                                Width="100"
                                                Margin="0,0,10,0"
                                                BorderThickness="0"
                                                Command="{Binding StartManTestCommand}"
                                                Content="{DynamicResource BtnStartManTest}"
                                                IsEnabled="{Binding IsNotProcessing}" />
                                -->
                                <!--<Button Content="{DynamicResource BtnOpenVEyeWindow}" Width="110" Command="{Binding OpenVEyeWindowCommand}" Margin="0,0,10,0" BorderThickness="0"/>-->
                                <!--

                                            <DockPanel Width="230" HorizontalAlignment="Right">
                                                <Button
                                                    Width="110"
                                                    Margin="0,0,10,0"
                                                    BorderThickness="0"
                                                    Command="{Binding SaveTestResultCommand}"
                                                    Content="{DynamicResource BtnSaveTestResult}"
                                                    IsEnabled="{Binding IsNotProcessing}" />
                                                <Button
                                                    Width="110"
                                                    BorderThickness="0"
                                                    Command="{Binding LoadTestResultCommand}"
                                                    Content="{DynamicResource BtnLoadTestResult}"
                                                    IsEnabled="{Binding IsNotProcessing}" />
                                            </DockPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>-->

                                <!--  状态指示  -->
                                <Border
                                    Background="#FFFFFFFF"
                                    CornerRadius="6"
                                    Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse
                                            Width="12"
                                            Height="12"
                                            Fill="#FF198754">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform x:Name="SpinnerTransform" Angle="0" CenterX="6" CenterY="6" />
                                            </Ellipse.RenderTransform>
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                RepeatBehavior="Forever"
                                                                Storyboard.TargetName="SpinnerTransform"
                                                                Storyboard.TargetProperty="Angle"
                                                                From="0"
                                                                To="360"
                                                                Duration="0:0:1" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <TextBlock
                                            Name="TestingStatus"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="#FF666666"
                                            Text="{DynamicResource Maping.Measurementinprogress}" />
                                    </StackPanel>
                                </Border>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!--  总进度条：ProgressBarAll → 绑定TotalTestProgress  -->
                                    <!--  总进度条  -->
                                    <ProgressBar
                                        x:Name="ProgressBarAll"
                                        Grid.Row="0"
                                        Height="10"
                                        Foreground="#FF198754"
                                        IsIndeterminate="False"
                                        Maximum="100"
                                        Minimum="0"
                                        Value="{Binding TotalTestProgress}">
                                        <ProgressBar.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard Storyboard="{StaticResource ProgressPulseAnimation}" />
                                            </EventTrigger>
                                        </ProgressBar.Triggers>

                                        <ProgressBar.Style>
                                            <Style BasedOn="{StaticResource {x:Type ProgressBar}}" TargetType="ProgressBar">
                                                <Setter Property="Visibility" Value="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsManualTesting}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsIndeterminate" Value="False">
                                                        <Setter Property="Foreground">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Offset="0" Color="#FF198754" />
                                                                    <GradientStop Offset="0.5" Color="#FF20B45A" />
                                                                    <GradientStop Offset="1" Color="#FF198754" />
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                    <!--  进度文本  -->
                                    <!--  总进度文本：手动测试时和总进度条一起隐藏（核心新增Style逻辑）  -->
                                    <TextBlock
                                        x:Name="ProgressTextAll"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="#666"
                                        Text="{Binding ProgressTextAll}"
                                        TextTrimming="CharacterEllipsis">
                                        <!--  新增：和总进度条完全一致的显示/隐藏逻辑  -->
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                                                <!--  基础状态：测试中（IsProcessing=true）显示，未开始则隐藏  -->
                                                <Setter Property="Visibility" Value="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <!--  触发状态：手动测试时强制隐藏，和总进度条联动  -->
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsManualTesting}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!--  单个Die进度条  -->
                                    <ProgressBar
                                        x:Name="ProgressBar"
                                        Grid.Row="1"
                                        Height="10"
                                        Margin="0,5"
                                        Foreground="#FF198754"
                                        IsIndeterminate="False"
                                        Maximum="100"
                                        Minimum="0"
                                        Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Value="{Binding SingleDieTestProgress}">
                                        <ProgressBar.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard Storyboard="{StaticResource ProgressPulseAnimation}" />
                                            </EventTrigger>
                                        </ProgressBar.Triggers>

                                    </ProgressBar>

                                    <!--  进度文本  -->
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="#666"
                                        Text="{Binding ProgressText}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>

                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Margin="0,7"
                            BorderBrush="Gray"
                            BorderThickness="0">
                            <DataGrid
                                x:Name="TestResultDataGrid"
                                AutoGenerateColumns="False"
                                EnableRowVirtualization="True"
                                HorizontalScrollBarVisibility="Auto"
                                IsReadOnly="False"
                                ItemsSource="{Binding FilteredTestResults}"
                                MouseDoubleClick="DataGrid_MouseDoubleClick"
                                ScrollViewer.IsDeferredScrollingEnabled="True"
                                SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                SelectionMode="Single"
                                SelectionUnit="FullRow"
                                VerticalScrollBarVisibility="Auto"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Binding="{Binding Id, Mode=OneWay}"
                                        Header="{DynamicResource GridHeader.No}"
                                        IsReadOnly="True" />
                                    <DataGridTextColumn
                                        Binding="{Binding MapY, Mode=OneWay}"
                                        Header="{DynamicResource Maping.GridHeader.Row}"
                                        IsReadOnly="True" />
                                    <DataGridTextColumn
                                        Binding="{Binding MapX, Mode=OneWay}"
                                        Header="{DynamicResource Maping.GridHeader.Col}"
                                        IsReadOnly="True" />

                                    <!--  1. AOI列（全选/反选改为按钮）  -->
                                    <DataGridTemplateColumn>
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                                    <TextBlock
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Text="AOI" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <!--  全选按钮  -->
                                                        <CheckBox
                                                            x:Name="selectAllCheckBox_AOI"
                                                            VerticalAlignment="Center"
                                                            IsChecked="{Binding DataContext.SelectAllAOI, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                        <!--  反选按钮  -->
                                                        <Button
                                                            Command="{Binding DataContext.InvertSelectAOICommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            Style="{StaticResource HeaderActionButtonStyle}"
                                                            ToolTip="{DynamicResource Maping.GridHeader.ReverseSelection}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>

                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding IsAOIEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    IsHitTestVisible="True"
                                                    Style="{StaticResource CellCheckBoxStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>


                                    <!--  2. IVL列（全选/反选改为按钮）  -->

                                    <DataGridTemplateColumn>
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                                    <TextBlock
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Text="IVL" />
                                                    <StackPanel Orientation="Horizontal">

                                                        <!--  全选按钮  -->

                                                        <CheckBox
                                                            x:Name="selectAllCheckBox_IVL"
                                                            VerticalAlignment="Center"
                                                            IsChecked="{Binding DataContext.SelectAllIVL, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                        <Button
                                                            Command="{Binding DataContext.InvertSelectIVLCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            Style="{StaticResource HeaderActionButtonStyle}"
                                                            ToolTip="{DynamicResource Maping.GridHeader.ReverseSelection}" />
                                                    </StackPanel>

                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding IsIVLEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    IsHitTestVisible="True"
                                                    Style="{StaticResource CellCheckBoxStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>


                                    <!--  3. EQE列（全选/反选改为按钮）  -->

                                    <DataGridTemplateColumn>
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                                    <TextBlock
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Text="EQE" />
                                                    <StackPanel Orientation="Horizontal">

                                                        <!--  全选按钮  -->

                                                        <CheckBox
                                                            x:Name="selectAllCheckBox_EQE"
                                                            VerticalAlignment="Center"
                                                            IsChecked="{Binding DataContext.SelectAllEQE, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                        <Button
                                                            Command="{Binding DataContext.InvertSelectEQECommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            Style="{StaticResource HeaderActionButtonStyle}"
                                                            ToolTip="{DynamicResource Maping.GridHeader.ReverseSelection}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding IsEQEEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    IsHitTestVisible="True"
                                                    Style="{StaticResource CellCheckBoxStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>


                                    <!--  4. VAM列（全选/反选改为按钮）  -->

                                    <DataGridTemplateColumn>
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                                    <TextBlock
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Text="VAM" />
                                                    <StackPanel Orientation="Horizontal">

                                                        <!--  全选按钮  -->
                                                        <CheckBox
                                                            x:Name="selectAllCheckBox_VAM"
                                                            VerticalAlignment="Center"
                                                            IsChecked="{Binding DataContext.SelectAllVAM, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                        <Button
                                                            Command="{Binding DataContext.InvertSelectVAMCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            Style="{StaticResource HeaderActionButtonStyle}"
                                                            ToolTip="{DynamicResource Maping.GridHeader.ReverseSelection}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding IsVAMEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    IsHitTestVisible="True"
                                                    Style="{StaticResource CellCheckBoxStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Binding="{Binding SerialNumber, Mode=TwoWay}" Header="{DynamicResource Maping.GridHeader.SerialNumber}" />
                                    <DataGridTextColumn
                                        Binding="{Binding DisplayStatus, Mode=OneWay}"
                                        Header="{DynamicResource Maping.GridHeader.TestStatus}"
                                        IsReadOnly="True" />
                                    <DataGridTextColumn
                                        Binding="{Binding DataValue, Mode=OneWay}"
                                        Header="{DynamicResource Maping.GridHeader.Uniformity}"
                                        IsReadOnly="True" />
                                    <DataGridTextColumn
                                        Binding="{Binding StartTestTime, Mode=OneWay}"
                                        Header="{DynamicResource Maping.GridHeader.StartTestTime}"
                                        IsReadOnly="True" />
                                    <DataGridTextColumn
                                        Binding="{Binding EndTestTime, Mode=OneWay}"
                                        Header="{DynamicResource Maping.GridHeader.EndTestTime}"
                                        IsReadOnly="True" />

                                    <DataGridTextColumn
                                        Binding="{Binding TotalTime, Mode=OneWay}"
                                        Header="{DynamicResource Maping.GridHeader.TotalTime}"
                                        IsReadOnly="True" />
                                </DataGrid.Columns>

                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="{Binding Status, Converter={StaticResource StatusColorConverter}}" />
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>
                        </Border>

                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
