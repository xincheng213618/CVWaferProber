<UserControl
    x:Class="CVWaferProber.Components.MappingDataControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ccv="clr-namespace:CVWaferProber.Core.Converters;assembly=CVWaferProber.Core"
    xmlns:cv="clr-namespace:CVWaferProber.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CVWaferProber.Components"
    xmlns:map="clr-namespace:ChipMapping.Views;assembly=ChipMapping"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:CVWaferProber.ViewModels">

    <UserControl.Resources>
        <cv:StatusToColorConverter x:Key="StatusColorConverter" />
        <ccv:NotBooleanConverter x:Key="NotBooleanConverter" />
        <Storyboard x:Key="ProgressPulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.7" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="1.0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.0" Value="0.7" />
            </DoubleAnimationUsingKeyFrames>

            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)">
                <DiscreteColorKeyFrame KeyTime="0:0:0" Value="#FF198754" />
                <DiscreteColorKeyFrame KeyTime="0:0:0.5" Value="#FF20B45A" />
                <DiscreteColorKeyFrame KeyTime="0:0:1.0" Value="#FF198754" />
            </ColorAnimationUsingKeyFrames>
        </Storyboard>
        <!--  全局配色/圆角常量  -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#FF0078D7" />
        <SolidColorBrush x:Key="PrimaryDarkColor" Color="#FF005FB8" />
        <SolidColorBrush x:Key="PrimaryLightColor" Color="#FFE1EFFF" />
        <SolidColorBrush x:Key="BorderGrayColor" Color="#FFCCCCCC" />
        <CornerRadius x:Key="DefaultCornerRadius">2</CornerRadius>
        <!--  表头Checkbox样式（自定义外观）  -->
        <Style x:Key="HeaderCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="IsThreeState" Value="True" />
            <!--  启用三态  -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <!--  未选中边框  -->
                            <Border
                                x:Name="Border"
                                Background="White"
                                BorderBrush="{StaticResource BorderGrayColor}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource DefaultCornerRadius}" />
                            <!--  选中对勾  -->
                            <Path
                                x:Name="CheckMark"
                                Data="M2,7 L6,11 L13,4"
                                Stroke="{StaticResource PrimaryColor}"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="2"
                                Visibility="Collapsed" />
                            <!--  部分选中黑方框  -->
                            <Rectangle
                                x:Name="IndeterminateBox"
                                Width="8"
                                Height="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="Black"
                                Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryLightColor}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <!--  部分选中态（IsChecked=null）：显示黑方框  -->
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Border" Property="Background" Value="White" />
                                <!--<Setter TargetName="IndeterminateBox" Property="Visibility" Value="Visible" />-->
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  表头反选按钮样式（增强视觉/交互）  -->
        <Style x:Key="HeaderActionButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderGrayColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <!--<Setter Property="CornerRadius" Value="{StaticResource DefaultCornerRadius}"/>StrokeEndLineCap="Square" StrokeStartLineCap="Square"-->
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <!--  强制自定义模板，避免系统样式覆盖  -->
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="RootBorder"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource DefaultCornerRadius}">
                            <!--  直接内嵌图标，取消Content绑定，强制显示  -->
                            <Path
                                Width="10"
                                Height="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M1,6 L4,3 M1,6 L4,9 M11,6 L8,3 M11,6 L8,9 M5,6 L7,6"
                                Stretch="Uniform"
                                Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                StrokeEndLineCap="Square"
                                StrokeLineJoin="Bevel"
                                StrokeStartLineCap="Square"
                                StrokeThickness="1.1" />
                        </Border>
                        <!--  强制触发器，优先级最高  -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource PrimaryColor}" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource PrimaryDarkColor}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource PrimaryDarkColor}" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#FF00479E" />
                                <Setter Property="Padding" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!--  强制默认前景色  -->
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}" />
        </Style>
        <!--  反选图标  -->
