<UserControl
    x:Class="ChipMapping.Views.ChipMappingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ccv="clr-namespace:CVWaferProber.Core.Converters;assembly=CVWaferProber.Core"
    xmlns:conv="clr-namespace:ChipMapping.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa6="http://schemas.fontawesome.com/icons/fonts"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:ChipMapping.ViewModels"
    Background="White"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ccv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <conv:EnumBooleanConverter x:Key="EnumBooleanConverter" />
        <conv:PositionConverter x:Key="PositionConverter" />
        <conv:CenterOffsetConverter x:Key="CenterOffsetConverter" />
        <conv:SelectedToStrokeBrushConverter x:Key="SelectedToStrokeBrushConverter" />
        <conv:SelectedToStrokeThicknessConverter x:Key="SelectedToStrokeThicknessConverter" />
        <conv:BoolToCursorConverter x:Key="BoolToCursorConverter" />
        <conv:CursorTypeConverter x:Key="CursorTypeConverter" />
        <!--  添加闪烁转换器  -->
        <conv:BlinkFillConverter x:Key="BlinkFillConverter" />

        <!--  网格背景画刷  -->
        <DrawingBrush
            x:Key="GridPattern"
            TileMode="Tile"
            Viewport="0,0,20,20"
            ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="White">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,20,20" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFF5F5F5">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,20,20" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFE0E0E0" Pen="{x:Null}">
                        <GeometryDrawing.Geometry>
                            <LineGeometry StartPoint="0,20" EndPoint="20,0" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!--  长方形芯片样式  -->
        <Style x:Key="ChipRectangleStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="{Binding Width}" />
            <Setter Property="Height" Value="{Binding Height}" />
            <Setter Property="Fill">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource BlinkFillConverter}">
                        <Binding Path="IsSelected" />
                        <Binding Path="IsBlinking" />
                        <Binding Path="Status" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="Stroke" Value="{Binding IsSelected, Converter={StaticResource SelectedToStrokeBrushConverter}}" />
            <Setter Property="StrokeThickness" Value="{Binding IsSelected, Converter={StaticResource SelectedToStrokeThicknessConverter}}" />
            <Setter Property="RadiusX" Value="1" />
            <Setter Property="RadiusY" Value="1" />
            <Setter Property="ToolTip">
                <Setter.Value>
                    <ToolTip
                        Background="White"
                        BorderBrush="#FFCCCCCC"
                        Foreground="#FF333333">
                        <TextBlock
                            MaxWidth="200"
                            Text="{Binding ToolTip}"
                            TextWrapping="Wrap" />
                    </ToolTip>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  详细信息面板样式  -->
        <Style x:Key="DetailsPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FF007ACC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="10" />
        </Style>

        <!--  工具栏样式  -->
        <Style TargetType="ToolBar">
            <Setter Property="Background" Value="#FFF0F0F0" />
            <Setter Property="BorderBrush" Value="#FFCCCCCC" />
        </Style>

        <!--  状态栏样式  -->
        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="#FFF0F0F0" />
            <Setter Property="BorderBrush" Value="#FFCCCCCC" />
        </Style>

        <!--  按钮样式  -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFCCCCCC" />
            <Setter Property="Foreground" Value="#FF333333" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="8,2" />
        </Style>

        <!--  复选框样式  -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FF333333" />
            <Setter Property="Margin" Value="5,0" />
        </Style>

        <!--  文本块样式  -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF333333" />
        </Style>

        <!--  滑块样式  -->
        <Style TargetType="Slider">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="60" />
        </Style>

        <!--  文本框样式  -->
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="40" />
            <Setter Property="Margin" Value="2" />
        </Style>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:ChipMappingControlViewModel />
    </UserControl.DataContext>

    <Grid Background="White" Cursor="{Binding EnabledInput, Converter={StaticResource BoolToCursorConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  工具栏  -->
        <ToolBar Grid.Row="0">
            <!--<Button Content="刷新" Command="{Binding RefreshCommand}"/>
            <Separator/>-->

            <!--  缩放控制  -->
            <Button Command="{Binding ZoomInCommand}">
                <!--  直接使用 FontAwesome 控件，Kind 属性指定图标类型  -->
                <fa6:FontAwesome FontSize="14" Icon="Solid_MagnifyingGlassPlus" />
            </Button>
            <Button Command="{Binding ZoomOutCommand}">
                <fa6:FontAwesome FontSize="14" Icon="Solid_MagnifyingGlassMinus" />
            </Button>
            <Button Command="{Binding ResetCommand}">
                <fa6:FontAwesome FontSize="14" Icon="Solid_Expand" />
            </Button>
            <TextBlock
                Margin="5,0"
                VerticalAlignment="Center"
                Text="Zoom:" />
            <Slider
                Width="60"
                Maximum="5"
                Minimum="0.1"
                Value="{Binding Scale}" />
            <TextBlock
                Width="40"
                VerticalAlignment="Center"
                Text="{Binding Scale, StringFormat={}{0:P0}}" />

            <Separator />

            <!--  行列布局控制  -->
            <!--
            <TextBlock
                Margin="5,0"
                VerticalAlignment="Center"
                Text="Layout:" />
            <TextBlock
                Margin="2,0"
                VerticalAlignment="Center"
                Text="Row:" />
            <TextBox IsEnabled="False" Text="{Binding Rows}" />
            <TextBlock
                Margin="2,0"
                VerticalAlignment="Center"
                Text="Col:" />
            <TextBox IsEnabled="False" Text="{Binding Columns}" />
            <Separator />-->
            <TextBlock
                Margin="5,0"
                VerticalAlignment="Center"
                Text="Temperature:" />
            <TextBox IsEnabled="False" Text="{Binding Temperatures, StringFormat='{}{0}℃'}" />
            <Separator />
            <TextBlock
                Margin="2,0"
                VerticalAlignment="Center"
                Text="Probe Pressure:" />
            <TextBox IsEnabled="False" Text="{Binding Pressure}" />
            <Separator />
            <TextBlock
                Margin="5,0"
                VerticalAlignment="Center"
                Text="Probe Card SN:" />
            <TextBox IsEnabled="False" Text="{Binding SN}" />
            <Separator />
            <TextBlock
                Margin="2,0"
                VerticalAlignment="Center"
                Text="TD Count:" />
            <TextBox IsEnabled="False" Text="{Binding TDCount}" />
            <TextBlock
                Margin="2,0"
                VerticalAlignment="Center"
                Text="良率:" />
            <TextBox
                Width="80"
                IsEnabled="False"
                Text="{Binding DataContext.YieldInfo, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <!--
            <TextBlock Text="间距:" VerticalAlignment="Center" Margin="5,0"/>
            <TextBlock Text="水平:" VerticalAlignment="Center" Margin="2,0"/>
            <TextBox Text="{Binding HorizontalSpacing}" ToolTip="水平间距"/>
            <TextBlock Text="垂直:" VerticalAlignment="Center" Margin="2,0"/>
            <TextBox Text="{Binding VerticalSpacing}" ToolTip="垂直间距"/>

            <TextBlock Text="起始:" VerticalAlignment="Center" Margin="5,0"/>
            <TextBlock Text="X:" VerticalAlignment="Center" Margin="2,0"/>
            <TextBox Text="{Binding StartX}" ToolTip="起始X坐标"/>
            <TextBlock Text="Y:" VerticalAlignment="Center" Margin="2,0"/>
            <TextBox Text="{Binding StartY}" ToolTip="起始Y坐标"/>
            -->




            <!-- 筛选控制
            <TextBlock Text="筛选:" VerticalAlignment="Center" Margin="5,0"/>
            <CheckBox Content="正常" IsChecked="{Binding FilterStatus, Converter={StaticResource EnumBooleanConverter}, ConverterParameter={x:Static enums:ChipStatus.OK}}"/>
            <CheckBox Content="NG_AOI" IsChecked="{Binding FilterStatus, Converter={StaticResource EnumBooleanConverter}, ConverterParameter={x:Static enums:ChipStatus.AOI_NG}}"/>
            <CheckBox Content="NG_Line" IsChecked="{Binding FilterStatus, Converter={StaticResource EnumBooleanConverter}, ConverterParameter={x:Static enums:ChipStatus.AOI_LINE_NG}}"/>
            <CheckBox Content="不亮" IsChecked="{Binding FilterStatus, Converter={StaticResource EnumBooleanConverter}, ConverterParameter={x:Static enums:ChipStatus.BLIND}}"/>
            -->
        </ToolBar>


        <!--  主画布区域  -->
        <Grid Grid.RowSpan="2" Margin="0,26,0,0">
            <ScrollViewer
                Background="White"
                BorderBrush="#FFCCCCCC"
                BorderThickness="0,1,0,0"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
                <Canvas
                    x:Name="MainCanvas"
                    Width="{Binding CanvasWidth}"
                    Height="{Binding CanvasHeight}"
                    Background="{StaticResource GridPattern}"
                    MouseLeave="MainCanvas_MouseLeave"
                    MouseLeftButtonDown="MainCanvas_MouseLeftButtonDown"
                    MouseMove="MainCanvas_MouseMove">

                    <Canvas.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
                    </Canvas.LayoutTransform>

                    <ItemsControl ItemsSource="{Binding FilteredChips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Position.X, Converter={StaticResource PositionConverter}}" />
                                <Setter Property="Canvas.Top" Value="{Binding Position.Y, Converter={StaticResource PositionConverter}}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Rectangle Style="{StaticResource ChipRectangleStyle}">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform X="{Binding Width, Converter={StaticResource CenterOffsetConverter}}" Y="{Binding Height, Converter={StaticResource CenterOffsetConverter}}" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </ScrollViewer>

            <!--  详细信息面板  -->
            <Border Style="{StaticResource DetailsPanelStyle}" Visibility="{Binding SelectedChip, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="14"
                        FontWeight="Bold"
                        Text="Detail Info" />
                    <TextBlock
                        MaxWidth="300"
                        Text="{Binding ChipDetails}"
                        TextWrapping="Wrap" />
                    <Button
                        Margin="0,10,0,0"
                        Padding="10,2"
                        HorizontalAlignment="Right"
                        Click="ClearSelectionButton_Click"
                        Content="ClearSelected" />
                </StackPanel>
            </Border>
        </Grid>
        <!--<StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding Temperature, StringFormat=Temperature: {0:F1}°C}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding Pressure, StringFormat=Pressure: {0:F1}kPa}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding SN, StringFormat=ProbeCardSN: {0:F1}}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding TDCount, StringFormat=TDCount: {0:F1}}" />
            </StatusBarItem>

        </StatusBar>-->




    </Grid>
</UserControl>