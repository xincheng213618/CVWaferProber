<UserControl
    x:Class="CVWPFSpectrometerCtrl.CVSpectrumAnalyzer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CVWPFSpectrometerCtrl.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oxy="http://oxyplot.org/wpf"
    xmlns:sp="clr-namespace:CVWPFSpectrumControl;assembly=CVWPFSpectrumControl"
    xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    mc:Ignorable="d">
    <UserControl.DataContext>
        <local:CVSpectrumViewModel />
    </UserControl.DataContext>
    <UserControl.Resources />
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <StackPanel
            Grid.Row="0"
            Margin="0"
            Orientation="Horizontal">
            <!--<Button x:Name="btnConnect" Content="连接设备" IsEnabled="False" Width="80" Margin="5" Command="{Binding DevConnectCommand}"/>
            <Button x:Name="btnStart" Content="测试" IsEnabled="False"  Width="80" Margin="5" Command="{Binding DevTestCommand}"/>-->
            <Button
                x:Name="btnExport"
                Width="80"
                Margin="5"
                Command="{Binding ExportCommand}"
                CommandParameter="{Binding SelectedTabIndex}"
                Content="{DynamicResource Export CSV}"
                IsEnabled="True" />
        </StackPanel>

        <!--  Tab区域  -->
        <TabControl
            Grid.Row="1"
            Margin="5"
            SelectedIndex="{Binding SelectedTabIndex}">
            <!--  光谱分析Tab  -->
            <TabItem Header="{DynamicResource Sp.Spectral}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35*" />
                        <ColumnDefinition Width="218*" />
                        <ColumnDefinition Width="253*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="8*" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>

                    <!--  图表区域  -->
                    <oxy:PlotView
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Margin="5,5,5,5"
                        Model="{Binding PlotModel}" />

                    <!--  DataGrid区域  -->
                    <DataGrid
                        x:Name="measurementsGrid"
                        Grid.Row="1"
                        Grid.ColumnSpan="3"
                        Margin="5,5,5,5"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="False"
                        CanUserResizeRows="False"
                        CanUserSortColumns="True"
                        GridLinesVisibility="All"
                        IsReadOnly="True"
                        ItemsSource="{Binding Measurements}"
                        RowHeight="25"
                        SelectedItem="{Binding SelectedMeasurement}"
                        SelectionMode="Single"
                        SelectionUnit="FullRow">

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding MeasurementId}"
                                Header="{DynamicResource Sp.MeasurementBatch}" />
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                Header="{DynamicResource Sp.Time}" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding V, StringFormat='F4'}"
                                Header="{DynamicResource Sp.Voltage}" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding I, StringFormat='F4'}"
                                Header="{DynamicResource Sp.Current}" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Luminance, StringFormat='F4'}"
                                Header="{DynamicResource Sp.Luminance}" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding CIE_x, StringFormat='F4'}"
                                Header="{DynamicResource ColorCoordinateX}" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding CIE_y, StringFormat='F4'}"
                                Header="{DynamicResource ColorCoordinateY}" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding CIE_u, StringFormat='F4'}"
                                Header="{DynamicResource ColorCoordinateU}" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding CIE_v, StringFormat='F4'}"
                                Header="{DynamicResource ColorCoordinateV}" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding CCT, StringFormat='F1'}"
                                Header="{DynamicResource ColorTemperature}" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding PeakWavelength, StringFormat='F4'}"
                                Header="{DynamicResource DominantWavelength}" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding PeakIntensity, StringFormat='F4'}"
                                Header="{DynamicResource PeakWavelength}" />
                        </DataGrid.Columns>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="LightBlue" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!--  IV特性Tab  -->
            <TabItem Header="IV">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="8*" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>

                    <!--  IV图表区域  -->
                    <oxy:PlotView
                        Grid.Row="0"
                        Margin="5"
                        Model="{Binding IVPlotModel}" />

                    <!--  IV DataGrid区域  -->
                    <DataGrid
                        Grid.Row="1"
                        Margin="5"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="False"
                        CanUserResizeRows="False"
                        CanUserSortColumns="True"
                        GridLinesVisibility="All"
                        IsReadOnly="True"
                        ItemsSource="{Binding IVMeasurements}"
                        RowHeight="25"
                        SelectionMode="Single"
                        SelectionUnit="FullRow">

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="50"
                                Binding="{Binding No}"
                                Header="{DynamicResource GridHeader.No}" />
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                Header="{DynamicResource Sp.Time}" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Voltage, StringFormat='F4'}"
                                Header="{DynamicResource Sp.Voltage}" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Current, StringFormat='F4'}"
                                Header="{DynamicResource Sp.Current}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!--  IL特性Tab  -->
            <TabItem Header="IL">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="8*" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>

                    <!--  IL图表区域  -->
                    <oxy:PlotView
                        x:Name="plotView"
                        Grid.Row="0"
                        Margin="5"
                        Background="White"
                        Cursor="Cross"
                        Model="{Binding ILPlotModel}" />

                    <!--  当前数据点信息栏  -->
                    <!--
                    <Border
                        Grid.Row="1"
                        Margin="0,5"
                        Padding="12"
                        Background="#E8F4FD"
                        BorderBrush="#BBDEFB"
                        BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#1976D2"
                                Text="📊 当前数据点: " />

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#1976D2"
                                Text="{Binding StatusText}"
                                TextWrapping="Wrap" />

                            <StackPanel
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontStyle="Italic"
                                    Foreground="#666666"
                                    Text="💡 提示: " />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontStyle="Italic"
                                    Foreground="#666666"
                                    Text="鼠标在图表上移动查看数据点详细信息" />
                            </StackPanel>
                        </Grid>
                    </Border>-->

                    <!--  IL DataGrid区域  -->
                    <DataGrid
                        Grid.Row="1"
                        Margin="5"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="False"
                        CanUserResizeRows="False"
                        CanUserSortColumns="True"
                        GridLinesVisibility="All"
                        IsReadOnly="True"
                        ItemsSource="{Binding ILMeasurements}"
                        RowHeight="25"
                        SelectionMode="Single"
                        SelectionUnit="FullRow">

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="50"
                                Binding="{Binding No}"
                                Header="{DynamicResource GridHeader.No}" />
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                Header="{DynamicResource Sp.Time}" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Current, StringFormat='F4'}"
                                Header="{DynamicResource Sp.Current}" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Luminance, StringFormat='F4'}"
                                Header="{DynamicResource Sp.Luminance}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <!--  VL特性Tab  -->
            <TabItem Header="VL">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="67*" />
                        <ColumnDefinition Width="275*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="8*" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>

                    <!--  IL图表区域  -->
                    <oxy:PlotView
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Margin="5,5,5,5"
                        Model="{Binding VLPlotModel}" />

                    <!--  IL DataGrid区域  -->
                    <DataGrid
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="5,5,5,5"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="False"
                        CanUserResizeRows="False"
                        CanUserSortColumns="True"
                        GridLinesVisibility="All"
                        IsReadOnly="True"
                        ItemsSource="{Binding VLMeasurements}"
                        RowHeight="25"
                        SelectionMode="Single"
                        SelectionUnit="FullRow">

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="50"
                                Binding="{Binding No}"
                                Header="{DynamicResource GridHeader.No}" />
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                Header="{DynamicResource Sp.Time}" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Voltage, StringFormat='F4'}"
                                Header="{DynamicResource Sp.Voltage}" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Luminance, StringFormat='F4'}"
                                Header="{DynamicResource Sp.Luminance}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <!--  IVLCamera特性Tab  -->
            <TabItem Header="{DynamicResource IVLCamera}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="8*" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>

                    <!--  图像区域  -->
                    <Border
                        Grid.Row="0"
                        Margin="5"
                        BorderBrush="Gray"
                        BorderThickness="1">
                        <Image Source="{Binding IVLCameraImageSrc}" />
                    </Border>
                    <!--  IVLCamera DataGrid区域  -->
                    <DataGrid
                        x:Name="ivlCameraGrid"
                        Grid.Row="1"
                        Margin="5"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="False"
                        CanUserResizeRows="False"
                        CanUserSortColumns="True"
                        GridLinesVisibility="All"
                        IsReadOnly="True"
                        ItemsSource="{Binding IVLCameraMeasurements}"
                        RowHeight="25"
                        SelectedItem="{Binding SelectedCameraMeasurement}"
                        SelectionMode="Single"
                        SelectionUnit="FullRow">

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="50"
                                Binding="{Binding No}"
                                Header="{DynamicResource GridHeader.No}" />
                            <DataGridTextColumn
                                Width="130"
                                Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                Header="{DynamicResource Sp.Time}" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding V, StringFormat='F4'}"
                                Header="{DynamicResource Sp.Voltage}" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding I, StringFormat='F4'}"
                                Header="{DynamicResource Sp.Current}" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Luminance, StringFormat='F4'}"
                                Header="{DynamicResource Sp.Luminance}" />
                            <DataGridTextColumn
                                Width="480"
                                Binding="{Binding ImageFile}"
                                Header="{DynamicResource Image}" />
                        </DataGrid.Columns>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="LightBlue" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
