<Window
    x:Class="CVVAMControl.VamExportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CVVAMControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="VAM数据导出配置"
    Width="432"
    Height="400"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid Margin="20">

        <!--  导出模式选择  -->

        <StackPanel>
            <TextBlock
                Margin="0,0,0,5"
                FontWeight="Bold"
                Text="导出模式" />
            <RadioButton
                x:Name="rbLine"
                Margin="0,0,0,5"
                Content="线条（直径线）"
                IsChecked="True" />
            <RadioButton
                x:Name="rbCircle"
                Margin="0,0,0,10"
                Content="圆环（R圆）" />


            <!--  通道选择  -->

            <TextBlock
                Margin="0,0,0,5"
                FontWeight="Bold"
                Text="选择导出通道" />
            <CheckBox
                x:Name="cbX"
                Margin="0,0,0,2"
                Content="X通道" />
            <CheckBox
                x:Name="cbY"
                Margin="0,0,0,2"
                Content="Y通道"
                IsChecked="True" />
            <CheckBox
                x:Name="cbZ"
                Margin="0,0,0,2"
                Content="Z通道" />
            <CheckBox
                x:Name="cbCieX"
                Margin="0,0,0,2"
                Content="cieX通道" />
            <CheckBox
                x:Name="cbCieY"
                Margin="0,0,0,10"
                Content="cieY通道" />


            <!--  线条模式参数  -->

            <StackPanel x:Name="pnlLineParams" Visibility="Visible">
                <TextBlock
                    Margin="0,0,0,5"
                    FontWeight="Bold"
                    Text="线条参数" />
                <StackPanel Margin="0,0,0,2" Orientation="Horizontal">
                    <TextBlock Width="150" Text="极角范围（polar_RHO）：" />
                    <TextBox
                        x:Name="txtLinePolarRHO"
                        Width="100"
                        Text="60" />
                    <TextBlock Margin="5,0,0,0" Text="°（[-值,值]）" />
                </StackPanel>
                <StackPanel Margin="0,0,0,2" Orientation="Horizontal">
                    <TextBlock Width="150" Text="极角采样点数：" />
                    <TextBox
                        x:Name="txtLineSampleCount"
                        Width="100"
                        Text="121" />
                    <TextBlock x:Name="LineSampleCountBook" Margin="5,0,0,0" Text="（[-60,60]共121点）" />
                </StackPanel>
            </StackPanel>


            <!--  圆环模式参数  -->

            <StackPanel x:Name="pnlCircleParams" Visibility="Collapsed">
                <TextBlock
                    Margin="0,0,0,5"
                    FontWeight="Bold"
                    Text="圆环参数" />
                <StackPanel Margin="0,0,0,2" Orientation="Horizontal">
                    <TextBlock Width="150" Text="极角起始值：" />
                    <TextBox
                        x:Name="txtCirclePolarStart"
                        Width="100"
                        Text="10" />
                    <TextBlock Margin="5,0,0,0" Text="°" />
                </StackPanel>
                <StackPanel Margin="0,0,0,2" Orientation="Horizontal">
                    <TextBlock Width="150" Text="极角结束值：" />
                    <TextBox
                        x:Name="txtCirclePolarEnd"
                        Width="100"
                        Text="80" />
                    <TextBlock Margin="5,0,0,0" Text="°" />
                </StackPanel>
                <StackPanel Margin="0,0,0,2" Orientation="Horizontal">
                    <TextBlock Width="150" Text="极角间隔：" />
                    <TextBox
                        x:Name="txtCirclePolarStep"
                        Width="100"
                        Text="10" />
                    <TextBlock Margin="5,0,0,0" Text="°" />
                </StackPanel>
                <StackPanel Margin="0,0,0,2" Orientation="Horizontal">
                    <TextBlock Width="150" Text="方位角采样点数：" />
                    <TextBox
                        x:Name="txtCircleSampleCount"
                        Width="100"
                        Text="120" />
                    <TextBlock x:Name="CircleSampleCountBook" Margin="5,0,0,0" Text="（[0,360)间隔3°）" />
                </StackPanel>
            </StackPanel>


            <!--  按钮  -->

            <StackPanel
                Margin="0,20,10,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    x:Name="btnExport"
                    Width="80"
                    Margin="0,0,10,0"
                    Click="btnExport_Click"
                    Content="导出" />
                <Button
                     Background="#DC3545"
                    Foreground="White"
                    x:Name="btnCancel"
                    Width="80"
                    Click="btnCancel_Click"
                    Content="取消" />

            </StackPanel>
        </StackPanel>

    </Grid>
</Window>
