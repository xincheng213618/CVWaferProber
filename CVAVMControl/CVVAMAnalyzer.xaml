<UserControl
    x:Class="CVAVMControl.CVVAMAnalyzer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ScottPlot="http://schemas.scottplot.net/2008/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CVAVMControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oxy="http://oxyplot.org/wpf"
    xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    mc:Ignorable="d">
    <Grid Margin="5">
        <!--  总体布局：3行2列     Background="#FF2D2D30"  -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  第1行：打开文件按钮  -->
            <RowDefinition Height="1.15*" />
            <RowDefinition Height="Auto" />
            <!--  第2行：伪彩图  -->
            <RowDefinition Height="*" />
            <!--  第3行：图表区  -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <!--  第1列：伪彩图 + 图表区  -->
            <ColumnDefinition Width="Auto" />
            <!--  第2列：切换按钮 + 参数区  -->
        </Grid.ColumnDefinitions>


        <!--  第1行：合并列 - 打开CVCIE文件按钮  -->
        <Button
            x:Name="btnOpenFile"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Height="40"
            Margin="0,0,0,10"
            Click="BtnOpenFile_Click"
            Content="{DynamicResource VAM.OpenCVCIEFile}"
            FontSize="16" />


        <!--  第2行第1列：伪彩图  -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,0,5,5"
            BorderBrush="#FF3F3F46"
            BorderThickness="1">
            <Grid x:Name="LayoutRoot">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="tbImageTitle"
                    Grid.Row="0"
                    Margin="5"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Text="{DynamicResource VAM.PseudocolorImage}" />
                <Grid
                    x:Name="imgGrid"
                    Grid.Row="1"
                    SizeChanged="ImgGrid_SizeChanged">

                    <Grid.Clip>
                        <RectangleGeometry x:Name="imgGridClip" />
                    </Grid.Clip>

                    <Image
                        x:Name="imgDisplay"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MouseLeave="ImgDisplay_MouseLeave"
                        MouseMove="ImgDisplay_MouseMove"
                        MouseWheel="ImgDisplay_MouseWheel"
                        Stretch="Uniform">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <!--  平移变换（补偿缩放偏移）  -->
                                <TranslateTransform x:Name="imgTranslateTransform" />
                                <!--  缩放变换  -->
                                <ScaleTransform x:Name="imgScaleTransform" ScaleX="1" ScaleY="1" />
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </Grid>

            </Grid>
        </Border>
        <!--  添加GridSplitter  -->
        <GridSplitter
            Grid.Row="2"
            Height="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="Transparent"
            ShowsPreview="True" />

        <!--  第3行第1列：图表区（包含两个图表面板）  -->
        <Border
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,5,0,0"
            BorderBrush="#FF3F3F46"
            BorderThickness="1">
            <Grid>
                <!--  直径线分布曲线（默认显示）  -->
                <Grid x:Name="chartPanelDiameter" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Margin="5"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Text="{DynamicResource Plot.Title.DiameterLine}" />
                    <ScottPlot:WpfPlot
                        x:Name="wpfPlotDiameterLine"
                        Grid.Row="1"
                        Margin="5"
                        Loaded="WpfPlot_Loaded" />
                </Grid>

                <!--  R圆分布曲线（默认隐藏）  -->
                <Grid x:Name="chartPanelRCircle" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Margin="5"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Text="{DynamicResource Plot.Title.RCircle}" />
                    <ScottPlot:WpfPlot
                        x:Name="wpfPlotRCircle"
                        Grid.Row="1"
                        Margin="5"
                        Loaded="WpfPlot_Loaded" />
                </Grid>
            </Grid>
        </Border>


        <!--  第2行第2列 + 第3行第2列：合并行 - 切换按钮 + 参数区  -->
        <Border
            Grid.Row="1"
            Grid.Column="1"
            Margin="5,0,0,5"
            BorderBrush="#FF3F3F46"
            BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!--  切换按钮  -->
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <!--  参数区  -->
                </Grid.RowDefinitions>

                <!--  切换按钮（默认显示“R圆分布曲线”）  -->
                <Button
                    x:Name="btnSwitchChart"
                    Grid.Row="0"
                    Height="30"
                    Margin="5"
                    Click="BtnSwitchChart_Click"
                    Content="{DynamicResource Plot.Title.RCircle}"
                    FontSize="14" />

                <!--  参数区  -->
                <Grid Grid.Row="1">
                    <!--  面板1：直径线参数（默认显示）  -->
                    <StackPanel x:Name="paramPanelDiameter" Visibility="Visible">
                        <!--  原第二行前两项  -->
                        <StackPanel Margin="5,5,5,10" Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Text="{DynamicResource VAM.ViewingAngle}" />
                            <ComboBox
                                x:Name="cbDisplayAngle"
                                Width="100"
                                SelectedIndex="4"
                                SelectionChanged="CbDisplayAngle_SelectionChanged">
                                <ComboBoxItem Content="0°" Tag="0" />
                                <ComboBoxItem Content="30°" Tag="30" />
                                <ComboBoxItem Content="60°" Tag="60" />
                                <ComboBoxItem Content="90°" Tag="90" />
                                <ComboBoxItem Content="120°" Tag="120" />
                                <ComboBoxItem Content="150°" Tag="150" />
                                <ComboBoxItem Content="180°" Tag="180" />
                            </ComboBox>
                            <Button
                                Margin="5,0,5,0"
                                Padding="10,2"
                                Click="BtnDeleteAngle_Diameter_Click"
                                Content="{DynamicResource VAM.Delete}" />
                        </StackPanel>
                        <StackPanel Margin="5,0,5,10" Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Text="{DynamicResource VAM.DisplayChannel}" />
                            <ComboBox
                                x:Name="cbDisplayChannel"
                                Width="151"
                                SelectedIndex="1"
                                SelectionChanged="CbDisplayChannel_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource VAM.XChannel}" Tag="X" />
                                <ComboBoxItem Content="{DynamicResource VAM.YChannel}" Tag="Y" />
                                <ComboBoxItem Content="{DynamicResource VAM.ZChannel}" Tag="Z" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0,5,0"
                                VerticalAlignment="Center"
                                Text="{DynamicResource VAM.AddAngle}" />
                            <TextBox
                                x:Name="txtAddAngle"
                                Width="100"
                                Height="18"
                                MinWidth="60"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center" />
                            <Button
                                Margin="0,0,5,0"
                                Padding="10,2"
                                Click="BtnAddAngle_Diameter_Click"
                                Content="{DynamicResource VAM.Add}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0,5,0"
                                VerticalAlignment="Center"
                                Text="{DynamicResource VAM.SampleCount}" />
                            <TextBox
                                x:Name="pointNumLineBox"
                                Width="100"
                                Height="18"
                                MinWidth="60"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center" />
                            <Button
                                Margin="0,0,5,0"
                                Padding="10,2"
                                Click="Button_Click"
                                Content="{DynamicResource VAM.Apply}" />
                        </StackPanel>
                        <!--  导出直径线CSV按钮  -->
                        <Button
                            x:Name="btnExportDiameter"
                            Height="30"
                            Margin="5"
                            Click="BtnExportDiameter_Click"
                            Content="{DynamicResource VAM.ExportDiameterLineCSV}" />


                    </StackPanel>

                    <!--  面板2：R圆参数（默认隐藏）  -->
                    <StackPanel x:Name="paramPanelRCircle" Visibility="Collapsed">
                        <!--  原第二行最后一项  -->
                        <StackPanel Margin="5,5,5,10" Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Text="{DynamicResource VAM.RCircleRadius}" />
                            <ComboBox
                                x:Name="cbDisplayRadius"
                                Width="100"
                                SelectedIndex="2"
                                SelectionChanged="CbDisplayRadius_SelectionChanged">
                                <ComboBoxItem Content="0°" Tag="0" />
                                <ComboBoxItem Content="20°" Tag="20" />
                                <ComboBoxItem Content="40°" Tag="40" />
                                <ComboBoxItem Content="60°" Tag="60" />

                            </ComboBox>
                            <Button
                                Margin="5,0,5,0"
                                Padding="10,2"
                                Click="BtnDeleteAngle_RCircle_Click"
                                Content="{DynamicResource VAM.Delete}" />
                        </StackPanel>
                        <StackPanel Margin="5,0,0,10" Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Text="{DynamicResource VAM.AddAngle}" />
                            <TextBox
                                x:Name="txtAddAngle1"
                                Width="100"
                                Height="18"
                                MinWidth="60"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center" />
                            <Button
                                Margin="0,0,5,0"
                                Padding="10,2"
                                Click="BtnAddAngle_RCircle_Click"
                                Content="{DynamicResource VAM.Add}" />
                        </StackPanel>

                        <!--  导出R圆CSV按钮  -->
                        <Button
                            x:Name="btnExportCircle"
                            Height="35"
                            Margin="5"
                            Click="BtnExportCircle_Click"
                            Content="{DynamicResource VAM.ExportRCircleCSV}" />

                    </StackPanel>

                </Grid>
                <StackPanel Grid.Row="2" Margin="5,0,5,5">
                    <Button
                        x:Name="btnExport"
                        Height="30"
                        Margin="0,5"
                        Click="BtnExport_Click"
                        Content="导出" />
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>