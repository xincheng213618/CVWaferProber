<UserControl
    x:Class="CVAVMControl.CVVAMAnalyzer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ScottPlot="http://schemas.scottplot.net/2008/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CVAVMControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oxy="http://oxyplot.org/wpf"
    xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    mc:Ignorable="d" d:Width="900" d:Height="600">
    <Grid Margin="5">
        <!--  总体布局：3行2列     Background="#FF2D2D30"  -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.15*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  第1行：合并列 - 打开CVCIE文件按钮  -->
        <Button
            x:Name="btnOpenFile"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Height="40"
            Margin="0,0,0,10"
            Click="BtnOpenFile_Click"
            Content="{DynamicResource VAM.OpenCVCIEFile}"
            FontSize="16" />
        <!-- 第4行：进度条区域（修复背景色和高度） -->
        <Border
            x:Name="progressBarContainer"
            Grid.Row="4"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="5,10,5,0"
            Padding="5"
            Background="#FF2D2D30" 
            BorderBrush="#FF3F3F46"
            BorderThickness="1"
            Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 进度条 -->
                <ProgressBar
                    x:Name="exportProgressBar"
                    Grid.Column="0"
                    Height="20"
                    Background="#FF1E1E1E"
                    Foreground="#FF007ACC"
                    Maximum="100"
                    Minimum="0"
                    Value="0">
                    <!-- 添加进度条样式 -->
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="#FF3F3F46"/>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <!-- 进度文本 -->
                <TextBlock
                    x:Name="exportProgressText"
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="White"
                    Text="0%" />
            </Grid>
        </Border>

        <!--  第2行第1列：伪彩图  -->
        <!--  MouseWheel="ImgDisplay_MouseWheel"  -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,0,5,5"
            BorderBrush="#FF3F3F46"
            BorderThickness="1">
            <Grid x:Name="LayoutRoot">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock  x:Name="tbImageTitle" Grid.Row="0"  Margin="5" HorizontalAlignment="Center" FontSize="14" Text="{DynamicResource VAM.PseudocolorImage}" />
                <Grid
                    x:Name="imgGrid"
                    Grid.Row="1"
                    SizeChanged="ImgGrid_SizeChanged">
                    <Grid.Clip>
                        <RectangleGeometry x:Name="imgGridClip" />
                    </Grid.Clip>

                    <Image
                        x:Name="imgDisplay"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MouseLeave="ImgDisplay_MouseLeave"
                        MouseMove="ImgDisplay_MouseMove"
                        Stretch="Uniform">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <!--  平移变换（补偿缩放偏移）  -->
                                <TranslateTransform x:Name="imgTranslateTransform" />
                                <!--  缩放变换  -->
                                <ScaleTransform x:Name="imgScaleTransform" ScaleX="1" ScaleY="1" />
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>


                </Grid>
                <Grid x:Name="GridInfo" Grid.Row="1" HorizontalAlignment="Left" Visibility="Collapsed" VerticalAlignment="Top" Height="100" Width="200" Margin="10,0,0,0" >
                    <Border  Background="Black" Opacity="0.5" CornerRadius="10">

                    </Border>
                    <TextBlock x:Name="_hoverInfoText" Text="" Foreground="White" TextWrapping ="NoWrap" Margin="10"/>
                </Grid>

            </Grid>
        </Border>

        <!--  添加GridSplitter  -->
        <GridSplitter
            Grid.Row="2"
            Height="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="Transparent"
            ShowsPreview="True" />

        <!--  第3行第1列：图表区（包含两个图表面板）  -->
        <Border
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,5,0,0"
            BorderBrush="#FF3F3F46"
            BorderThickness="1">
            <Grid>
                <!--  直径线分布曲线（默认显示）  -->
                <Grid x:Name="chartPanelDiameter" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Margin="5"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Text="{DynamicResource Plot.Title.DiameterLine}" />
                    <ScottPlot:WpfPlot
                        x:Name="wpfPlotDiameterLine"
                        Grid.Row="1"
                        Margin="5"
                        Loaded="WpfPlot_Loaded" />
                </Grid>

                <!--  R圆分布曲线（默认隐藏）  -->
                <Grid x:Name="chartPanelRCircle" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Margin="5"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Text="{DynamicResource Plot.Title.RCircle}" />
                    <ScottPlot:WpfPlot
                        x:Name="wpfPlotRCircle"
                        Grid.Row="1"
                        Margin="5"
                        Loaded="WpfPlot_Loaded" />
                </Grid>
            </Grid>
        </Border>


        <!--  第2行第2列 + 第3行第2列：合并行 - 切换按钮 + 参数区  -->
        <Border
            Grid.Row="1"
            Grid.Column="1"
            Margin="5,0,0,5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            BorderBrush="#FF3F3F46"
            BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!--  切换按钮  -->
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <!--  参数区  -->
                </Grid.RowDefinitions>

                <!--  切换按钮（默认显示“R圆分布曲线”）  -->
                <Button
                    x:Name="btnSwitchChart"
                    Grid.Row="0"
                    Height="30"
                    Margin="5"
                    Click="BtnSwitchChart_Click"
                    Content="{DynamicResource Plot.Title.RCircle}"
                    FontSize="14" />

                <!--  参数区  -->
                <Grid
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">

                    <!--  面板1：直径线参数（默认显示）  Background="AliceBlue"  -->
                    <StackPanel
                        x:Name="paramPanelDiameter"
                        Margin="5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Visibility="Visible">
                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border
                                Grid.Row="0"
                                Margin="0,0,0,5"
                                BorderBrush="#803F3F46"
                                BorderThickness="1">
                                <StackPanel Margin="5">
                                    <StackPanel
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Width="120"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Text="{DynamicResource VAM.ViewingAngle}" />
                                        <ComboBox
                                            x:Name="cbDisplayAngle"
                                            Width="100"
                                            VerticalAlignment="Center"
                                            SelectedIndex="4"
                                            SelectionChanged="CbDisplayAngle_SelectionChanged">
                                            <ComboBoxItem Content="0°" Tag="0" />
                                            <ComboBoxItem Content="30°" Tag="30" />
                                            <ComboBoxItem Content="60°" Tag="60" />
                                            <ComboBoxItem Content="90°" Tag="90" />
                                            <ComboBoxItem Content="120°" Tag="120" />
                                            <ComboBoxItem Content="150°" Tag="150" />
                                            <ComboBoxItem Content="180°" Tag="180" />
                                        </ComboBox>
                                        <Button
                                            Width="80"
                                            Margin="8,0,0,0"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Click="BtnDeleteAngle_Diameter_Click"
                                            Content="{DynamicResource VAM.Delete}" />
                                    </StackPanel>

                                    <StackPanel
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Width="120"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Text="{DynamicResource VAM.DisplayChannel}" />
                                        <ComboBox
                                            x:Name="cbDisplayChannel"
                                            Width="188"
                                            VerticalAlignment="Center"
                                            SelectedIndex="1"
                                            SelectionChanged="CbDisplayChannel_SelectionChanged">
                                            <ComboBoxItem Content="{DynamicResource VAM.XChannel}" Tag="X" />
                                            <ComboBoxItem Content="{DynamicResource VAM.YChannel}" Tag="Y" />
                                            <ComboBoxItem Content="{DynamicResource VAM.ZChannel}" Tag="Z" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Width="120"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Text="{DynamicResource VAM.AddAngle}" />
                                        <TextBox
                                            x:Name="txtAddAngle"
                                            Width="100"
                                            Height="22"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center" />
                                        <Button
                                            Width="80"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Click="BtnAddAngle_Diameter_Click"
                                            Content="{DynamicResource VAM.Add}" />
                                    </StackPanel>

                                    <!--<StackPanel
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Width="120"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Text="{DynamicResource VAM.SampleCount}" />
                                        <TextBox
                                            x:Name="pointNumLineBox"
                                            Width="100"
                                            Height="22"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center" />
                                        <Button
                                            Width="80"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Click="Button_Click"
                                            Content="{DynamicResource VAM.Apply}" />
                                    </StackPanel>-->
                                    <!--  导出按钮单独对齐  -->
                                    <Button
                                        x:Name="btnExportDiameter1"
                                        Width="400"
                                        Height="30"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Center"
                                        Click="BtnExportDiameter_Click1"
                                        Content="{DynamicResource VAM.ExportAzimuthLineCSV1}"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Button.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform />
                                                <SkewTransform AngleY="-0.074" />
                                                <RotateTransform />
                                                <TranslateTransform Y="-0.221" />
                                            </TransformGroup>
                                        </Button.RenderTransform>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Expander
                                Grid.Row="1"
                                BorderThickness="1"
                                Header="{DynamicResource VAM.Exportparameterconfiguration}">
                                <Border
                                    Margin="0,5,0,5"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    BorderBrush="#803F3F49"
                                    BorderThickness="1">
                                    <StackPanel Margin="5,0">
                                        <StackPanel
                                            Margin="0,10,0,8"
                                            HorizontalAlignment="Left"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                Width="120"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                Text="{DynamicResource VAM.ExporChannel}" />
                                            <CheckBox
                                                x:Name="cbExportX"
                                                Margin="0,0,10,0"
                                                Content="X" />
                                            <CheckBox
                                                x:Name="cbExportY"
                                                Margin="0,0,10,0"
                                                Content="Y"
                                                IsChecked="True" />
                                            <CheckBox
                                                x:Name="cbExportZ"
                                                Margin="0,0,10,0"
                                                Content="Z" />
                                            <CheckBox
                                                x:Name="cbExportCieX"
                                                Margin="0,0,10,0"
                                                Content="cx" />
                                            <CheckBox
                                                x:Name="cbExportCieY"
                                                Margin="0,0,10,0"
                                                Content="cy" />
                                        </StackPanel>
                                        <!--<StackPanel
                                            Margin="0,0,0,8"
                                            HorizontalAlignment="Left"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                Width="120"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center" />

                                        </StackPanel>-->
                                        <!--  线条模式参数（原VamExportDialog的线条参数）  -->
                                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                            <TextBlock
                                                Width="120"
                                                Margin="0,0,5,0"
                                                Text="{DynamicResource VAM.Polar_RHO}"
                                                ToolTip="Polar_RHO" />

                                            <TextBox
                                                x:Name="txtLinePolarRHO"
                                                Width="100"
                                                Text="60" />
                                            <TextBlock Margin="5,0,0,0" Text="{DynamicResource VAM.Value}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                            <TextBlock
                                                Width="120"
                                                Margin="0,0,5,0"
                                                Text="{DynamicResource VAM.Angleinterval}" />
                                            <TextBox
                                                x:Name="txtLinePolarInterval"
                                                Width="100"
                                                Text="1" />
                                            <!--  默认间隔1°，对应[-60,60]共121点  -->
                                            <TextBlock
                                                x:Name="LinePolarIntervalBook"
                                                Margin="5,0,0,0"
                                                Text="" />
                                        </StackPanel>
                                        <!--  导出按钮（替换原btnExportDiameter）  -->
                                        <Button
                                            x:Name="btnExportDiameter"
                                            Width="400"
                                            Height="30"
                                            Margin="0,10,0,5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Click="BtnExportDiameter_Click"
                                            Content="{DynamicResource VAM.ExportDiameterLineCSV}" />
                                        <!--<StackPanel Grid.Row="2" Margin="5,0,5,5">
                                            <Button
                                                x:Name="btnExport"
                                                Width="380"
                                                Height="30"
                                                Margin="0,5"
                                                HorizontalAlignment="Center"

                                                Content="{DynamicResource Export CSV}" />
                                        </StackPanel>-->
                                    </StackPanel>
                                </Border>

                            </Expander>

                        </Grid>
                        <!--  统一控件尺寸：设置TextBlock宽度、控件对齐方式  -->


                    </StackPanel>
                    <!--  面板2：R圆参数（默认隐藏）  -->

                    <StackPanel
                        x:Name="paramPanelRCircle"
                        Margin="5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  上层Border：R圆核心参数操作区（对应Panel1上层）  -->
                            <Border
                                Grid.Row="0"
                                Margin="0,0,0,5"
                                BorderBrush="#803F3F46"
                                BorderThickness="1">
                                <StackPanel Margin="5">
                                    <StackPanel
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Width="120"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Text="{DynamicResource VAM.RCircleRadius}" />
                                        <ComboBox
                                            x:Name="cbDisplayRadius"
                                            Width="100"
                                            VerticalAlignment="Center"
                                            SelectedIndex="2"
                                            SelectionChanged="CbDisplayRadius_SelectionChanged">
                                            <ComboBoxItem Content="0°" Tag="0" />
                                            <ComboBoxItem Content="20°" Tag="20" />
                                            <ComboBoxItem Content="40°" Tag="40" />
                                            <ComboBoxItem Content="60°" Tag="60" />
                                        </ComboBox>
                                        <Button
                                            Width="80"
                                            Margin="8,0,0,0"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Click="BtnDeleteAngle_RCircle_Click"
                                            Content="{DynamicResource VAM.Delete}" />
                                    </StackPanel>

                                    <StackPanel
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Width="120"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Text="{DynamicResource VAM.AddAngle}" />
                                        <TextBox
                                            x:Name="txtAddAngle1"
                                            Width="100"
                                            Height="22"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center" />
                                        <Button
                                            Width="80"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Click="BtnAddAngle_RCircle_Click"
                                            Content="{DynamicResource VAM.Add}" />
                                    </StackPanel>




                                    <!--  导出R圆CSV按钮 - 与Panel1导出按钮对齐统一  -->
                                    <Button
                                        x:Name="btnExportCircle1"
                                        Width="400"
                                        Height="30"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Stretch"
                                        Click="BtnExportCircle_Click1"
                                        Content="{DynamicResource VAM.ExportRCircleCSV1}" />
                                </StackPanel>
                            </Border>

                            <!--  下层Border：R圆导出配置区（对应Panel1下层）  -->
                            <Expander
                                Grid.Row="1"
                                BorderThickness="1"
                                Header="{DynamicResource VAM.Exportparameterconfiguration}">
                                <Border
                                    Grid.Row="1"
                                    Margin="0,5,0,5"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    BorderBrush="#803F3F46"
                                    BorderThickness="1">
                                    <StackPanel Margin="5">
                                        <!--  导出通道选择  -->
                                        <StackPanel
                                            Margin="0,10,0,8"
                                            HorizontalAlignment="Left"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                Width="140"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                Text="{DynamicResource VAM.ExporChannel}" />
                                            <CheckBox
                                                x:Name="cbCircleExportX"
                                                Margin="0,0,10,0"
                                                Content="X" />
                                            <CheckBox
                                                x:Name="cbCircleExportY"
                                                Margin="0,0,10,0"
                                                Content="Y"
                                                IsChecked="True" />
                                            <CheckBox
                                                x:Name="cbCircleExportZ"
                                                Margin="0,0,10,0"
                                                Content="Z" />
                                            <CheckBox
                                                x:Name="cbCircleExportCieX"
                                                Margin="0,0,5,0"
                                                Content="cx" />
                                            <CheckBox
                                                x:Name="cbCircleExportCieY"
                                                Margin="0,0,10,0"
                                                Content="cy" />
                                        </StackPanel>

                                        <!--<StackPanel
                                            Margin="0,0,0,8"
                                            HorizontalAlignment="Left"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                Width="140"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center" />
                                            <CheckBox
                                                x:Name="cbCircleExportCieX"
                                                Margin="0,0,5,0"
                                                Content="{DynamicResource VAM.cieXChannel}" />
                                            <CheckBox
                                                x:Name="cbCircleExportCieY"
                                                Margin="0,0,55,0"
                                                Content="{DynamicResource VAM.cieYChannel}" />
                                        </StackPanel>-->

                                        <!--  圆环模式参数（原VamExportDialog的圆环参数）  -->
                                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                            <TextBlock
                                                Width="140"
                                                Margin="0,0,5,0"
                                                Text="{DynamicResource VAM.Startingvalue}" />
                                            <TextBox
                                                x:Name="txtCirclePolarStart"
                                                Width="100"
                                                Text="10" />
                                            <TextBlock Margin="5,0,0,0" Text="°" />
                                        </StackPanel>

                                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                            <TextBlock
                                                Width="140"
                                                Margin="0,0,5,0"
                                                Text="{DynamicResource VAM.Endingvalue}" />
                                            <TextBox
                                                x:Name="txtCirclePolarEnd"
                                                Width="100"
                                                Text="60" />
                                            <TextBlock Margin="5,0,0,0" Text="°" />
                                        </StackPanel>

                                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                            <TextBlock
                                                Width="140"
                                                Margin="0,0,5,0"
                                                Text="{DynamicResource VAM.Angleinterval}" />
                                            <TextBox
                                                x:Name="txtCirclePolarStep"
                                                Width="100"
                                                Text="10" />
                                            <TextBlock Margin="5,0,0,0" Text="°" />
                                        </StackPanel>

                                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                            <TextBlock
                                                Width="140"
                                                Margin="0,0,5,0"
                                                Text="{DynamicResource VAM.Azimuthinterval}" />
                                            <TextBox
                                                x:Name="txtAzimuthInterval"
                                                Width="100"
                                                Text="3" />
                                            <!--  默认间隔3°，对应[0,360)共120点  -->
                                            <TextBlock
                                                x:Name="AzimuthIntervalBook"
                                                Margin="5,0,0,0"
                                                Text="" />
                                        </StackPanel>
                                        <!--  导出按钮 - 与Panel1导出按钮对齐统一  -->
                                        <Button
                                            x:Name="btnExportCircle"
                                            Width="400"
                                            Height="30"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Center"
                                            Click="BtnExportCircle_Click"
                                            Content="{DynamicResource VAM.ExportRCircleCSV}" />
                                    </StackPanel>
                                </Border>
                            </Expander>

                        </Grid>
                    </StackPanel>
                </Grid>
                <!--<StackPanel Grid.Row="2" Margin="5,0,5,5">
                    <Button
                        x:Name="btnExport"
                        Width="343"
                        Height="30"
                        Margin="0,5"
                        HorizontalAlignment="Left"
                        Click="BtnExport_Click"
                        Content="{DynamicResource Export CSV}" />
                </StackPanel>-->


            </Grid>
        </Border>

    </Grid>
</UserControl>