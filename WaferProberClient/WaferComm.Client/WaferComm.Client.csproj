  <ItemGroup>
    <PackageReference Include="log4net" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WaferComm.Core\WaferComm.Core.csproj" />
  </ItemGroup>

</Project>
