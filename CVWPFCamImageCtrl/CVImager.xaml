<UserControl x:Class="CVWPFCamImageCtrl.CVImager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CVWPFCamImageCtrl">
    <UserControl.Resources>
        <!-- 细腻的渐变背景 -->
        <LinearGradientBrush x:Key="ModernBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFAFAFA" Offset="0"/>
            <GradientStop Color="#FFF0F0F0" Offset="0.3"/>
            <GradientStop Color="#FFFAFAFA" Offset="0.7"/>
            <GradientStop Color="#FFF0F0F0" Offset="1"/>
        </LinearGradientBrush>
        <!-- 方格背景 -->
        <DrawingBrush x:Key="CheckerboardBackground2" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,16,16"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <VisualBrush>
                            <VisualBrush.Visual>
                                <Grid Width="16" Height="16">
                                    <Rectangle Fill="#FFD0D0D0" Width="8" Height="8"/>
                                    <Rectangle Fill="#FFFFFFFF" Width="8" Height="8" HorizontalAlignment="Right"/>
                                    <Rectangle Fill="#FFFFFFFF" Width="8" Height="8" VerticalAlignment="Bottom"/>
                                    <Rectangle Fill="#FFD0D0D0" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                </Grid>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <!-- 方格背景画刷 -->
        <DrawingBrush x:Key="CheckerboardBackground" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,20,20" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <VisualBrush>
                            <VisualBrush.Visual>
                                <Grid Width="20" Height="20">
                                    <Rectangle Fill="#FFE0E0E0" Width="10" Height="10" />
                                    <Rectangle Fill="#FFFFFFFF" Width="10" Height="10" HorizontalAlignment="Right" />
                                    <Rectangle Fill="#FFFFFFFF" Width="10" Height="10" VerticalAlignment="Bottom" />
                                    <Rectangle Fill="#FFE0E0E0" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                </Grid>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <Border BorderThickness="1" BorderBrush="SlateGray">
        <ScrollViewer x:Name="MainScrollViewer" 
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto"
                      Background="{StaticResource ModernBackground}"
                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">

            <Grid x:Name="ImageContainer" Background="Transparent">
                <Image x:Name="DisplayImage" 
                       Source="{Binding CurrentImage}"
                       Stretch="None"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ImageScaleTransform" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="ImageTranslateTransform" X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>

                <!-- 显示缩放比例和图像信息的文本框 
                <Border Background="#CCFFFFFF" 
                        Padding="5" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Top"
                        Margin="5"
                        CornerRadius="3">
                    <StackPanel>
                        <TextBlock x:Name="ScaleTextBlock" Text="缩放: 100%" FontWeight="Bold"/>
                        <TextBlock x:Name="ImageInfoTextBlock" Text="" FontSize="10"/>
                    </StackPanel>
                </Border>
                -->
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
