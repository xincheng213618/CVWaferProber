<UserControl x:Class="CVWPFCamImageCtrl.CVCamImagerCtrl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CVWPFCamImageCtrl"
             xmlns:cv="clr-namespace:CVWPFCamImageCtrl.Converters">
    <UserControl.Resources>
        <cv:ZoomScaleConverter x:Key="ZoomScaleConverter"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>
    </UserControl.Resources>
    <UserControl.DataContext>
        <local:CVCamImagerViewModel/>
    </UserControl.DataContext>
    <DockPanel>
        <!-- 顶部工具栏 - 增强版 -->
        <ToolBar DockPanel.Dock="Top" Background="#FFF0F0F0" Height="40">
            <!-- 基本操作按钮组 -->
            <StackPanel Orientation="Horizontal" Margin="5,0">
                <Button Content="🔍放大" Click="ZoomIn_Click" ToolTip="放大图像 (Ctrl + +)"/>
                <Button Content="🔍缩小" Click="ZoomOut_Click" ToolTip="缩小图像 (Ctrl + -)"/>
                <Button Content="⭕原始" Click="ZoomOriginal_Click" ToolTip="恢复到原始大小 (Ctrl + 0)"/>
                <Button Content="📏适应" Click="ZoomFit_Click" ToolTip="适应窗口大小 (Ctrl + F)"/>
                <Separator/>
                <Button Content="⬅上一张" Click="PreviousImage_Click" ToolTip="上一张图像 (Ctrl + ←)"/>
                <Button Content="➡下一张" Click="NextImage_Click" ToolTip="下一张图像 (Ctrl + →)"/>
            </StackPanel>

            <Separator/>

            <!-- 缩放信息显示组 -->
            <StackPanel Orientation="Horizontal" Margin="10,0">
                <!-- 缩放滑块 -->
                <TextBlock Text="缩放级别:"/>
                <Slider x:Name="ZoomSlider" Width="120" Minimum="1" Maximum="5000" 
                       Value="100" TickFrequency="10" IsSnapToTickEnabled="False"
                       ValueChanged="ZoomSlider_ValueChanged"/>

                <TextBlock Text="|" Foreground="#FFCCCCCC" Margin="8,0"/>
                <TextBlock Text="缩放:" FontWeight="Bold" Foreground="#FF333333"/>
                <TextBlock x:Name="ZoomPercentageText" Text="{Binding Value, ElementName=ZoomSlider,Converter={StaticResource ZoomScaleConverter}}" 
                         FontWeight="Bold" Foreground="#FF0066CC" MinWidth="40"/>

            </StackPanel>

            <Separator/>

            <StackPanel Orientation="Vertical">
            <!-- 图像尺寸信息组 -->
            <StackPanel Orientation="Horizontal" Margin="10,0">
                <TextBlock Text="图像尺寸:" FontWeight="Bold" Foreground="#FF333333"/>
                <TextBlock x:Name="ImageDimensionsText" Text="0 × 0 像素" 
                          MinWidth="100" ToolTip="原始图像尺寸"/>
                <TextBlock Text="|" Foreground="#FFCCCCCC" Margin="8,0"/>

                <TextBlock Text="显示尺寸:"/>
                <TextBlock x:Name="DisplayDimensionsText" Text="0 × 0 像素" 
                          MinWidth="100" ToolTip="当前显示尺寸"/>
                <TextBlock Text="|" Foreground="#FFCCCCCC" Margin="8,0"/>

                <TextBlock Text="分辨率:"/>
                <TextBlock x:Name="ResolutionText" Text="0 DPI" MinWidth="60"/>
            </StackPanel>

            <Separator/>

            <!-- 文件信息组 -->
            <StackPanel Orientation="Horizontal" Margin="10,0">
                <TextBlock Text="当前文件:" FontWeight="Bold"/>
                <TextBlock x:Name="CurrentFileNameText" Text="未选择" 
                          MaxWidth="200" TextTrimming="CharacterEllipsis"
                          ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <TextBlock Text="|" Foreground="#FFCCCCCC" Margin="8,0"/>

                <TextBlock Text="文件大小:"/>
                <TextBlock x:Name="FileSizeText" Text="0 MB" MinWidth="60"/>

                <TextBlock Text="进度:"/>
                <TextBlock x:Name="LoadingProgressText" Text="0/0" MinWidth="40"/>

                </StackPanel>
            </StackPanel>
            
        </ToolBar>

        <!-- 状态栏 -->
        <!--<StatusBar DockPanel.Dock="Bottom" Background="#FFE8E8E8">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="MemoryUsageText" Text="内存使用: 0 MB"/>
            </StatusBarItem>
        </StatusBar>-->

        <!-- 主内容区域 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧图像显示区域 -->
            <Grid x:Name="container" RenderTransformOrigin="0.5,0.5" Grid.Column="0">
                <local:CVImager x:Name="ImageDisplay" CurrentImage="{Binding ImageSrc}"  Margin="5"/>
            </Grid>
            <!-- 右侧数据网格区域 -->
            <GridSplitter Grid.Column="0" Width="3" HorizontalAlignment="Right" 
                         Background="Transparent" ShowsPreview="True"/>

            <DockPanel Grid.Column="1" Margin="0,5">
                <!--<TextBlock DockPanel.Dock="Top" Text="图像列表:" FontWeight="Bold" Margin="0,0,0,5"/>-->
                <!-- 文件操作按钮组 -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5" Background="#FFF0F0F0" Height="40">
                    <Button Content="🖼️文件" Click="LoadFile_Click" ToolTip="加载图像文件 (Ctrl+O)"/>
                    <Button Content="📁文件夹" Click="LoadFolder_Click" ToolTip="加载文件夹中的所有图像"/>
                    <Button Content="🔄重载" Click="ReloadImage_Click" ToolTip="重新加载当前图像 (F5)"/>
                    <Button Content="❌清除" Click="ClearAll_Click" ToolTip="清除所有图像"/>
                </StackPanel>
                <DataGrid x:Name="ImageDataGrid" 
                         ItemsSource="{Binding ImageResults}" 
                         AutoGenerateColumns="False"
                         SelectionChanged="ImageDataGrid_SelectionChanged"
                         IsReadOnly="True"
                         SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Binding="{Binding Id}" Width="40"/>
                        <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="200"/>
                        <DataGridTextColumn Header="路径" Binding="{Binding ImagePath}" Width="300"/>
                        <DataGridTextColumn Header="大小(MB)" Binding="{Binding FileSizeMB, StringFormat={}{0:F2}}"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
