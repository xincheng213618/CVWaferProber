<UserControl
    x:Class="CVWPFCamImageCtrl.CVCamImagerCtrl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:CVWPFCamImageCtrl.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CVWPFCamImageCtrl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d"  d:Width="1280" d:Height="720">
    <UserControl.Resources>
        <cv:ZoomScaleConverter x:Key="ZoomScaleConverter" />
        <cv:BoolToTextConverter
            x:Key="BoolToTextConverter"
            FalseValue="Data View:"
            TrueValue="数据视图:" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="MinWidth" Value="60" />
        </Style>
    </UserControl.Resources>
    <UserControl.DataContext>
        <local:CVCamImagerViewModel />
    </UserControl.DataContext>
    <DockPanel>
        <!--  顶部工具栏 - 增强版  -->
        <ToolBar
            Height="40"
            Background="#FFF0F0F0"
            DockPanel.Dock="Top">
            <!--  基本操作按钮组  -->
            <StackPanel Margin="5,0" Orientation="Horizontal">
                <Button
                    Click="ZoomIn_Click"
                    Content="{DynamicResource Zoom in}"
                    ToolTip="{DynamicResource Image.ZoomIn}" />
                <Button
                    Click="ZoomOut_Click"
                    Content="{DynamicResource Zoom out}"
                    ToolTip="{DynamicResource Image.ZoomOut}" />
                <Button
                    Click="ZoomOriginal_Click"
                    Content="{DynamicResource Original}"
                    ToolTip="{DynamicResource Image.RestoretoOriginal}" />
                <Button
                    Click="ZoomFit_Click"
                    Content="{DynamicResource Fit}"
                    ToolTip="{DynamicResource Image.Fit}" />
                <Separator />
                <Button
                    Click="PreviousImage_Click"
                    Content="{DynamicResource Previous}"
                    ToolTip="{DynamicResource Image.Previous}" />
                <Button
                    Click="NextImage_Click"
                    Content="{DynamicResource Next}"
                    ToolTip="{DynamicResource Image.Next}" />
            </StackPanel>

            <Separator />

            <!--  缩放信息显示组  -->
            <StackPanel Margin="10,0" Orientation="Horizontal">
                <!--  缩放滑块  -->
                <TextBlock FontWeight="Bold" Text="{DynamicResource Zoom level}" />
                <Slider
                    x:Name="ZoomSlider"
                    Width="120"
                    IsSnapToTickEnabled="False"
                    Maximum="5000"
                    Minimum="1"
                    TickFrequency="10"
                    ValueChanged="ZoomSlider_ValueChanged"
                    Value="100" />

                <TextBlock
                    Margin="8,0"
                    Foreground="#FFCCCCCC"
                    Text="|" />
                <TextBlock
                    FontWeight="Bold"
                    Foreground="#FF333333"
                    Text="{DynamicResource Zoom}" />
                <TextBlock
                    x:Name="ZoomPercentageText"
                    MinWidth="40"
                    FontWeight="Bold"
                    Foreground="#FF0066CC"
                    Text="{Binding Value, ElementName=ZoomSlider, Converter={StaticResource ZoomScaleConverter}}" />

            </StackPanel>

            <Separator />

            <StackPanel Orientation="Vertical">
                <!--  图像尺寸信息组  -->
                <StackPanel Margin="10,0" Orientation="Horizontal">
                    <TextBlock
                        FontWeight="Bold"
                        Foreground="#FF333333"
                        Text="{DynamicResource Image Dimensions}" />
                    <TextBlock
                        x:Name="ImageDimensionsText"
                        Margin="0,0,2,0"
                        Text=""
                        ToolTip="{DynamicResource Image.OriginalSize}" />
                    <TextBlock Text="{DynamicResource Pixels}" />
                    <TextBlock
                        Margin="8,0"
                        Foreground="#FFCCCCCC"
                        Text="|" />

                    <TextBlock FontWeight="Bold" Text="{DynamicResource Display Dimensions}" />

                    <TextBlock
                        x:Name="DisplayDimensionsText"
                        Margin="0,0,2,0"
                        Text=""
                        ToolTip="{DynamicResource Image.CurrentViewSize}" />
                    <TextBlock Text="{DynamicResource Pixels}" />
                    <TextBlock
                        Margin="8,0"
                        Foreground="#FFCCCCCC"
                        Text="|" />

                    <!--<TextBlock FontWeight="Bold" Text="{DynamicResource Resolution}" />
                    <TextBlock
                        x:Name="ResolutionText"
                        MinWidth="60"
                        Text="0 DPI" />-->
                </StackPanel>

                <Separator />

                <!--  文件信息组  -->
                <StackPanel Margin="10,0" Orientation="Horizontal">
                    <TextBlock FontWeight="Bold" Text="{DynamicResource CurrentFile}" />
                    <TextBlock
                        x:Name="CurrentFileNameText"
                        MaxWidth="200"
                        Text="{DynamicResource Unselected}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <TextBlock
                        Margin="8,0"
                        Foreground="#FFCCCCCC"
                        Text="|" />

                    <TextBlock FontWeight="Bold" Text="{DynamicResource FileSize}" />
                    <TextBlock
                        x:Name="FileSizeText"
                        MinWidth="60"
                        Text="0 MB" />

                    <!--<TextBlock FontWeight="Bold" Text="{DynamicResource Progress}" />
                    <TextBlock
                        x:Name="LoadingProgressText"
                        MinWidth="40"
                        Text="0/0" />-->

                </StackPanel>
            </StackPanel>

        </ToolBar>

        <!--  状态栏  -->
        <!--<StatusBar DockPanel.Dock="Bottom" Background="#FFE8E8E8">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="MemoryUsageText" Text="内存使用: 0 MB"/>
            </StatusBarItem>
        </StatusBar>-->

        <!--  主内容区域  -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!--  图像显示区域  -->
            <Grid
                x:Name="container"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                RenderTransformOrigin="0.5,0.5">
                <local:CVImager
                    x:Name="ImageDisplay"
                    Margin="5"
                    CurrentImage="{Binding ImageSrc}" />
            </Grid>
            <!--  添加GridSplitter  -->
            <GridSplitter
                Grid.Row="1"
                Height="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="Transparent"
                ShowsPreview="True" />

            <DockPanel
                Grid.Row="2"
                Grid.ColumnSpan="2"
                Margin="0,5">
                <!--<TextBlock DockPanel.Dock="Top" Text="图像列表:" FontWeight="Bold" Margin="0,0,0,5"/>-->
                <!--  文件操作按钮组  -->
                <StackPanel
                    Height="30"
                    Margin="0,0,0,5"
                    Background="#FFF0F0F0"
                    DockPanel.Dock="Top"
                    Orientation="Horizontal">
                    <Button
                        Click="LoadFile_Click"
                        Content="{DynamicResource File}"
                        ToolTip="{DynamicResource Image.Loadimagefile}" />
                    <Button
                        Click="LoadFolder_Click"
                        Content="{DynamicResource Folder}"
                        ToolTip="{DynamicResource Image.Loadallimagesinfolder}" />
                    <Button
                        Click="ReloadImage_Click"
                        Content="{DynamicResource Reload}"
                        ToolTip="{DynamicResource Image.Reloadcurrentimage}" />
                    <Button
                        Click="ClearAll_Click"
                        Content="{DynamicResource Clear}"
                        ToolTip="{DynamicResource Image.Clearallimages}" />
                    <!--  新增：下拉框（红框位置）- 切换数据视图  -->
                    <StackPanel
                        Background="#FFF0F0F0"
                        DockPanel.Dock="Top"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="10,0,5,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="{Binding Source={x:Static local:CVCamImagerCtrl.IsChineseMode}, Converter={StaticResource BoolToTextConverter}}" />
                        <ComboBox
                            x:Name="ViewSwitchComboBox"
                            VerticalAlignment="Center"
                            SelectedIndex="1"
                            SelectionChanged="ViewSwitchComboBox_SelectionChanged">
                            <ComboBoxItem Tag="Analysis">Analysis image</ComboBoxItem>
                            <ComboBoxItem Tag="Camera">Camera Measurement</ComboBoxItem>

                        </ComboBox>
                    </StackPanel>
                    <CheckBox
                        x:Name="RealTimePreviewCheckBox"
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Content="{DynamicResource Image.real-timepreview}"
                        IsChecked="{Binding IsRealTimePreviewEnabled}" />
                </StackPanel>
                <!--  ItemsSource="{Binding ImageResults}"  -->
                <DataGrid
                    x:Name="MainImageDataGrid"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding CurrentDisplayCollection}"
                    SelectedItem="{Binding SelectedImageItem, Mode=TwoWay}"
                    SelectionChanged="MainImageDataGrid_SelectionChanged"
                    SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="40"
                            Binding="{Binding Id}"
                            Header="{DynamicResource Image.GridHeader.Id}" />
                        <DataGridTextColumn
                            Width="200"
                            Binding="{Binding FileName}"
                            Header="{DynamicResource Image.GridHeader.FileName}" />
                        <DataGridTextColumn
                            Width="300"
                            Binding="{Binding ImagePath}"
                            Header="{DynamicResource Image.GridHeader.FilePath}" />
                        <DataGridTextColumn Binding="{Binding FileSizeMB, StringFormat={}{0:F2}}" Header="{DynamicResource Image.GridHeader.FileSize}" />
                        <DataGridTextColumn Binding="{Binding Status}" Header="{DynamicResource Image.GridHeader.Status}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
